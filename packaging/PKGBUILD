# Maintainer: Alexeyev Vitaly
#
# Разделённый пакет: одна сборка рабочего пространства — отдельные пакеты.
#   synshell-core   — композитор, оболочка, вход, клавиатура, снимки, портал, параметры, проводник,
#                     терминал, установка программ (обязательная часть);
#   synshell-mobile — оболочка телефона и его службы (модем, звонки, SMS, NFC, датчики);
#   synshell-game   — игровой режим и экранный контроллер;
#   synshell-link   — связь компьютера и телефона (synlink);
#   synshell-ai     — ассистент (нужна служба нейросетей synaptix);
#   synaptix        — служба нейросетей synaptixd: один пакет на все устройства — CUDA и NPU
#                     подгружаются во время работы (CUDA Toolkit для сборки не нужен), без NVIDIA
#                     служба работает на процессоре;
#   syn-*           — приложения, каждое отдельно (группа synshell-apps);
#   syn-quitsmoke   — «Бросить курить»: необязательное, не входит ни в метапакет, ни в группу;
#   mss-lsp         — языковой сервер MSS (syngui);
#   synshell        — метапакет: core и приложения «как у автора», без нейросетей.
pkgbase=synshell
pkgname=(synshell synshell-core synshell-mobile synshell-game synshell-link synshell-ai synaptix
         syn-notes syn-vm syn-video-player syn-audio-player syn-audio-recorder synpass syn-maps
         syn-remote syn-systeminfo syn-themeeditor syn-woman-cycle syndroid syn-wine-helper
         syncamera syn-blocks syn-epdtest syn-quitsmoke mss-lsp)
pkgver=0.1.42
pkgrel=185
pkgdesc="Окружение рабочего стола для Wayland на Rust и syngui"
arch=('x86_64' 'aarch64')
url="https://github.com/VitaminDB/synshell"
license=('GPL-3.0-only')
makedepends=('cargo' 'rust' 'git' 'clang' 'pkgconf'
             'mesa' 'libinput' 'seatd' 'libxkbcommon' 'libdrm' 'fontconfig' 'freetype2' 'dbus'
             'ffmpeg' 'sqlite' 'libarchive' 'pipewire' 'alsa-lib' 'fuse3')
# C-части крейтов (ring, zstd) с -flto из makepkg.conf не линкуются с Rust.
options=('!lto')

# Профиль cargo: release (LTO) — для AUR/GitHub; локально быстрее
# `cd packaging && SYNSHELL_PROFILE=fast-release makepkg -f`.
# Сборка идёт из packaging/: пакеты, pkg/ и src/ остаются там, корень чистый.
_profile=${SYNSHELL_PROFILE:-release}
# Возможности службы нейросетей: cuda (NVIDIA), npu (Intel); без них — только процессор.
_synaptix_features=${SYNAPTIXD_FEATURES:-cuda,npu}

_core_bins=(synwm syndesktop-shell synlogin synkeyboard synshot syn-screencast synsettings synfiles syn-terminal synpkg synfsd)
_mobile_bins=(synmobile-shell synmodem synmodemd synphone synsms synnfc synnfcd syn-nfc syn-compass syn-health)
_game_bins=(syngame-shell syngamepad)
_link_bins=(synlink synlink-view)
_ai_bins=(synassistant)
_app_crates=(syn-notes syn-vm syn-video-player syn-audio-player syn-audio-recorder synpass syn-maps syn-remote
             syn-systeminfo syn-themeeditor syn-woman-cycle syndroid syn-wine-helper syncamera syn-blocks syn-epdtest)

# Программа → крейт (каталог crates/<крейт>): крейты переименованы к syn-<имя>, программы — нет.
# (case, а не declare -A: makepkg подключает PKGBUILD внутри функции, и таблица была бы локальной).
_crate() {
    case "$1" in
        synwm) echo syn-wm ;; syndesktop-shell) echo syn-desktop-shell ;; synlogin) echo syn-login ;;
        synkeyboard) echo syn-keyboard ;; synshot) echo syn-shot ;; synsettings) echo syn-settings ;;
        synfiles) echo syn-files ;; synpkg) echo syn-pkg ;; synfsd) echo syn-fsd ;;
        synmobile-shell) echo syn-mobile-shell ;; synmodem|synmodemd) echo syn-modem ;; synphone) echo syn-phone ;;
        synsms) echo syn-sms ;; synnfc|synnfcd) echo syn-nfcd ;; syngame-shell) echo syn-game-shell ;;
        syngamepad) echo syn-gamepad ;; synlink) echo syn-link ;; synlink-view) echo syn-link-view ;;
        synassistant) echo syn-assistant ;; synpass) echo syn-pass ;; syncamera) echo syn-camera ;;
        syndroid|syndroidd) echo syn-droid ;;
        *) echo "$1" ;;
    esac
}

# Каталог рабочей копии syngui: соседний ../syngui при разработке или git-checkout cargo.
_syngui_dir() {
    cargo metadata --format-version 1 2>/dev/null | grep -o '"manifest_path":"[^"]*/mss-analysis/Cargo.toml"' \
        | head -1 | sed 's|"manifest_path":"||; s|/mss-analysis/Cargo.toml"||'
}

build() {
    cd "$startdir/.."
    local p=() c
    # Крейт syn-modem даёт synmodem и synmodemd, syn-nfcd — synnfc и synnfcd, syn-droid — syndroid и syndroidd.
    for c in "${_core_bins[@]}" "${_mobile_bins[@]}" "${_game_bins[@]}" "${_link_bins[@]}" "${_ai_bins[@]}" "${_app_crates[@]}" syn-quitsmoke; do
        c=$(_crate "$c")
        [[ " ${p[*]} " == *" $c "* ]] || p+=(-p "$c")
    done
    cargo build --profile "$_profile" "${p[@]}"
    cargo build --profile "$_profile" -p synaptixd --bins --features "$(echo "$_synaptix_features" | sed 's/[^,]*/synaptixd\/&/g')"
    # Языковой сервер MSS (syngui): ошибки, дополнение, подсказки в Kate/Helix/VS Code.
    local sg; sg=$(_syngui_dir)
    cargo build --profile "$_profile" --manifest-path "$sg/Cargo.toml" -p mss-lsp --target-dir target
}

check() {
    cd "$startdir/.."
    cargo test --profile "$_profile" -p synshell-common -p syn-wm -p syn-shot -p syn-login -p syn-pass
}

# Программа: файл в /usr/bin.
_bin() {
    install -Dm755 "$startdir/../target/$_profile/$1" "$pkgdir/usr/bin/$1"
}

# Ярлык и значок приложения из crates/<имя>/data (что есть).
_desktop() {
    local d="$startdir/../crates/$(_crate "$1")/data"
    [ -f "$d/$1.desktop" ] && install -Dm644 "$d/$1.desktop" "$pkgdir/usr/share/applications/$1.desktop"
    [ -f "$d/icons/$1.svg" ] && install -Dm644 "$d/icons/$1.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$1.svg"
    [ -f "$d/icons/$1.png" ] && install -Dm644 "$d/icons/$1.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$1.png"
    true
}

# Приложение: программа, ярлык, значок.
_app() {
    _bin "$1"
    _desktop "$1"
}

package_synshell() {
    pkgdesc="Окружение рабочего стола synshell: основа и приложения (без нейросетей)"
    depends=(synshell-core synshell-link synshell-game
             syn-notes syn-vm syn-video-player syn-audio-player syn-audio-recorder synpass syn-maps
             syn-remote syn-systeminfo syn-themeeditor syn-woman-cycle syndroid syn-wine-helper syncamera syn-blocks)
    optdepends=('synshell-ai: ассистент (нужна служба нейросетей synaptix)'
                'synshell-mobile: оболочка и службы телефона')
}

package_synshell-core() {
    pkgdesc="synshell: композитор synwm, оболочка, экран входа, клавиатура, снимки и показ экрана, параметры, проводник, терминал, установка программ"
    depends=('mesa' 'libinput' 'seatd' 'systemd-libs' 'libxkbcommon' 'libdrm' 'vulkan-icd-loader'
             'fontconfig' 'freetype2' 'ttf-font' 'dbus' 'ffmpeg' 'sqlite' 'libarchive' 'xdg-desktop-portal' 'pipewire')
    optdepends=('xorg-xwayland: X11-программы'
                'wireplumber: громкость (wpctl)'
                'sound-theme-freedesktop: звуковая тема freedesktop (запасная для событий)'
                'brightnessctl: яркость'
                'networkmanager: апплет сети'
                'iwd: Wi-Fi (или networkmanager)'
                'bluez: Bluetooth'
                'playerctl: мультимедийные клавиши'
                'wl-clipboard: снимки и пути к ним в буфер обмена'
                'xdg-desktop-portal-kde: запасной портал выбора файлов'
                'shared-mime-info: типы файлов в проводнике'
                'ffmpegthumbnailer: миниатюры видео в проводнике'
                'libheif: HEIC/HEIF/AVIF в просмотрщике и миниатюрах'
                'imagemagick: редкие форматы картинок (JPEG XL, RAW…) в просмотрщике'
                'breeze-icons: тема значков по умолчанию'
                'archlinux-appstream-data: категории, значки и снимки программ в synpkg'
                'polkit: установка программ (synpkg) без root'
                'base-devel: сборка пакетов AUR в synpkg'
                'pacman-contrib: проверка обновлений без root (checkupdates)'
                'udisks2: флешки и диски в проводнике'
                'gvfs-mtp: телефоны Android в проводнике (MTP)'
                'gvfs-gphoto2: камеры в проводнике (PTP)'
                'gvfs-afc: iPhone в проводнике'
                'gvfs-smb: сетевые папки Windows и Samba в проводнике'
                'git: метки git в проводнике'
                'fuse3: архивы как папки в проводнике'
                'intel-media-driver: аппаратное видео на Intel'
                'libva-mesa-driver: аппаратное видео на AMD'
                'nvidia-utils: кодер NVENC')
    # Прежнее имя пакета (всё в одном) и ещё более старое.
    provides=('syndesktop')
    conflicts=('syndesktop')
    replaces=('syndesktop')
    install=synshell-core.install
    cd "$startdir/.."
    local b
    for b in "${_core_bins[@]}"; do _bin "$b"; done
    for b in synsettings synpkg synfiles synshot syn-terminal; do _desktop "$b"; done
    install -Dm644 crates/syn-files/data/synfiles-viewer.desktop "$pkgdir/usr/share/applications/synfiles-viewer.desktop"
    install -Dm755 data/synshell-session "$pkgdir/usr/bin/synshell-session"
    ln -s synwm "$pkgdir/usr/bin/syndesktop"   # совместимость: старое имя композитора
    install -Dm644 data/synshell.desktop "$pkgdir/usr/share/wayland-sessions/synshell.desktop"
    # Звуковые темы synshell (XDG): synshell, -console, -crystal, -retro, -wood.
    local t
    for t in data/sounds/themes/*/; do
        t=$(basename "$t")
        install -Dm644 "data/sounds/themes/$t/index.theme" "$pkgdir/usr/share/sounds/$t/index.theme"
        install -Dm644 -t "$pkgdir/usr/share/sounds/$t/stereo" data/sounds/themes/$t/stereo/*
    done
    # Портал: выбор файлов, доступ, показ и снимки экрана — у оболочки (synsystem::portal_*).
    install -Dm644 data/synshell-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/synshell-portals.conf"
    install -Dm644 data/synshell.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/synshell.portal"
    # «Программы»: pacman через pkexec с отменой задания и своё правило polkit.
    install -Dm755 crates/syn-pkg/data/pacman-helper "$pkgdir/usr/lib/synpkg/pacman-helper"
    install -Dm644 crates/syn-pkg/data/org.synshell.synpkg.policy "$pkgdir/usr/share/polkit-1/actions/org.synshell.synpkg.policy"
    # Программы по умолчанию для типов файлов (XDG_CURRENT_DESKTOP=synshell); строка про
    # неустановленное приложение просто не сработает.
    { echo "[Default Applications]"; cat crates/*/data/defaults.mimeapps | grep -v '^#' | grep '='; } \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/synshell-mimeapps.list"
    install -Dm644 crates/synshell-ui/data/syndesktop-lock.pam "$pkgdir/etc/pam.d/syndesktop-lock"
    install -Dm644 crates/syn-login/data/synlogin.pam "$pkgdir/etc/pam.d/synlogin"
    install -Dm644 crates/syn-login/data/synlogin.service "$pkgdir/usr/lib/systemd/system/synlogin.service"
    install -Dm644 crates/syn-fsd/data/synfsd.service "$pkgdir/usr/lib/systemd/system/synfsd.service"
    install -Dm644 docs/FSD.md "$pkgdir/usr/share/doc/synshell/FSD.md"
    install -Dm644 crates/synshell-common/default-config.toml "$pkgdir/usr/share/doc/synshell/config.toml.example"
}

package_synshell-mobile() {
    pkgdesc="synshell для телефона: мобильная оболочка, модем (звонки, SMS, сеть), NFC, компас, шаги"
    depends=(synshell-core)
    cd "$startdir/.."
    local b
    for b in "${_mobile_bins[@]}"; do _bin "$b"; done
    for b in synphone synsms syn-nfc syn-compass syn-health; do _desktop "$b"; done
}

package_synshell-game() {
    pkgdesc="synshell: игровой режим (полноэкранная оболочка для геймпада) и экранный контроллер"
    depends=(synshell-core)
    cd "$startdir/.."
    local b
    for b in "${_game_bins[@]}"; do _bin "$b"; done
}

package_synshell-link() {
    pkgdesc="synshell: связь компьютера и телефона — экран, ввод, файлы, уведомления (synlink)"
    depends=(synshell-core)
    optdepends=('openssh: ssh на связанные устройства'
                'fuse3: файлы связанных устройств в проводнике')
    install=synshell-link.install
    cd "$startdir/.."
    _bin synlink
    _app synlink-view
    # Демон стартует с сеансом (synwm читает /etc/xdg/autostart).
    install -Dm644 crates/syn-link/autostart/synlink.desktop "$pkgdir/etc/xdg/autostart/synlink.desktop"
    # USB-сеть телефона: адрес по DHCP через systemd-networkd.
    install -Dm644 crates/syn-link/data/80-synlink-usb.network "$pkgdir/usr/lib/systemd/network/80-synlink-usb.network"
}

package_synshell-ai() {
    pkgdesc="synshell: ассистент — чаты, голосовой режим, инструменты (служба нейросетей synaptix)"
    depends=(synshell-core synaptix)
    cd "$startdir/.."
    _app synassistant
}

package_synaptix() {
    pkgdesc="Служба нейросетей synaptix: языковые модели, речь, картинки и видео для всех программ — на видеокарте NVIDIA, Intel NPU или процессоре"
    depends=('gcc-libs')
    optdepends=('nvidia-utils: драйвер NVIDIA (libcuda) — нейросети на видеокарте'
                'cuda: компилятор ядер NVRTC для видеокарты NVIDIA'
                'openvino-intel-npu-plugin: нейросети на Intel NPU (Core Ultra), вместе с intel-npu-driver и intel-npu-compiler'
                'intel-npu-driver: драйвер Intel NPU'
                'intel-npu-compiler: компилятор графов Intel NPU')
    backup=('etc/synaptix/synaptixd.toml')
    cd "$startdir/.."
    _bin synaptixd
    _bin synaptixctl
    install -Dm644 crates/synaptixd/data/synaptixd.service "$pkgdir/usr/lib/systemd/system/synaptixd.service"
    install -Dm644 crates/synaptixd/data/synaptixd.toml "$pkgdir/etc/synaptix/synaptixd.toml"
    install -Dm644 docs/MODELS.md "$pkgdir/usr/share/doc/synaptix/MODELS.md"
    install -dm755 "$pkgdir/usr/share/synaptix/models"
}

package_syn-notes() {
    pkgdesc="Заметки synshell: страницы-холсты, канбан, Гант, карты мыслей, календарь, напоминания"
    groups=(synshell-apps)
    depends=(synshell-core)
    optdepends=('poppler-glib: PDF в читалке')
    cd "$startdir/.."
    _app syn-notes
    # Хозяин проектов стартует с сеансом без окна (напоминания, рабочий стол).
    install -Dm644 crates/syn-notes/data/syn-notes-autostart.desktop "$pkgdir/etc/xdg/autostart/syn-notes.desktop"
}

package_syn-vm() {
    pkgdesc="Виртуальные машины synshell на QEMU/KVM: мастер, встроенный экран, снимки, USB и PCI, гостевой агент, CLI и MCP"
    groups=(synshell-apps)
    depends=(synshell-core)
    optdepends=('qemu-desktop: сами виртуальные машины'
                'edk2-ovmf: UEFI'
                'swtpm: TPM 2.0 для Windows 11'
                'virtiofsd: общая папка virtiofs (Windows)'
                'samba: общая папка по SMB'
                'virtio-win: драйверы и гостевой агент для Windows (AUR)')
    cd "$startdir/.."
    _app syn-vm
}

package_syn-video-player() {
    pkgdesc="Видеоплеер synshell: аппаратное декодирование, субтитры, нейрофильтры"
    groups=(synshell-apps)
    depends=(synshell-core ffmpeg)
    cd "$startdir/.."
    _app syn-video-player
    # Шрифты субтитров (OFL): в каталоге fontconfig — их видят и плеер, и образцы в настройках.
    install -Dm644 -t "$pkgdir/usr/share/fonts/synshell" crates/syn-video-player/data/fonts/*.ttf
    install -Dm644 crates/syn-video-player/data/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/fonts-OFL.txt"
}

