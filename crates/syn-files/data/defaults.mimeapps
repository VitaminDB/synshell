# Программа по умолчанию для типов (сводится в /usr/share/applications/synshell-mimeapps.list)
inode/directory=synfiles.desktop
# Архивы — папками в Проводнике (образы дисков, jar и apk — у своих программ)
application/zip=synfiles.desktop
application/x-zip-compressed=synfiles.desktop
application/x-tar=synfiles.desktop
application/x-compressed-tar=synfiles.desktop
application/x-bzip-compressed-tar=synfiles.desktop
application/x-bzip2-compressed-tar=synfiles.desktop
application/x-xz-compressed-tar=synfiles.desktop
application/x-zstd-compressed-tar=synfiles.desktop
application/x-lzma-compressed-tar=synfiles.desktop
application/x-lz4-compressed-tar=synfiles.desktop
application/x-lzip-compressed-tar=synfiles.desktop
application/x-tarz=synfiles.desktop
application/x-7z-compressed=synfiles.desktop
application/vnd.rar=synfiles.desktop
application/x-rar=synfiles.desktop
application/x-rar-compressed=synfiles.desktop
application/gzip=synfiles.desktop
application/x-gzip=synfiles.desktop
application/x-bzip=synfiles.desktop
application/x-bzip2=synfiles.desktop
application/x-xz=synfiles.desktop
application/zstd=synfiles.desktop
application/x-zstd=synfiles.desktop
application/x-lzma=synfiles.desktop
application/x-lz4=synfiles.desktop
application/x-lzip=synfiles.desktop
application/x-compress=synfiles.desktop
application/x-cpio=synfiles.desktop
application/x-cpio-compressed=synfiles.desktop
application/vnd.ms-cab-compressed=synfiles.desktop
application/x-lha=synfiles.desktop
application/x-lzh-compressed=synfiles.desktop
application/x-xar=synfiles.desktop
application/vnd.debian.binary-package=synfiles.desktop
application/x-rpm=synfiles.desktop
application/x-source-rpm=synfiles.desktop
# Картинки — в просмотрщике Проводника (снимки экрана, фото), а не в браузере
image/png=synfiles-viewer.desktop
image/jpeg=synfiles-viewer.desktop
image/gif=synfiles-viewer.desktop
image/bmp=synfiles-viewer.desktop
image/x-bmp=synfiles-viewer.desktop
image/webp=synfiles-viewer.desktop
image/svg+xml=synfiles-viewer.desktop
image/tiff=synfiles-viewer.desktop
image/heic=synfiles-viewer.desktop
image/heif=synfiles-viewer.desktop
image/avif=synfiles-viewer.desktop
image/x-icon=synfiles-viewer.desktop
image/vnd.microsoft.icon=synfiles-viewer.desktop
image/jxl=synfiles-viewer.desktop
image/x-portable-pixmap=synfiles-viewer.desktop
image/x-tga=synfiles-viewer.desktop
