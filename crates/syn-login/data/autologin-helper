#!/bin/sh
export LC_ALL=C
file=${SYNSHELL_AUTOLOGIN_HELPER_FILE:-/etc/synshell/autologin.toml}
[ "$(id -u)" = 0 ] || [ -n "$SYNSHELL_AUTOLOGIN_HELPER_FILE" ] || { echo "нужны права root" >&2; exit 1; }
[ $# = 3 ] || { echo "autologin-helper true|false ПОЛЬЗОВАТЕЛЬ СЕАНС" >&2; exit 2; }
enabled=$1 user=$2 session=$3
case $enabled in true|false) ;; *) echo "enabled: true или false" >&2; exit 2 ;; esac
printf '%s' "$user" | grep -Eqx '[a-z_][a-z0-9_-]{0,31}' || { echo "неверное имя пользователя" >&2; exit 2; }
printf '%s' "$session" | grep -Eqx '[A-Za-z0-9._+@/-]{1,128}' || { echo "неверный сеанс" >&2; exit 2; }
case $session in *..*|*[!A-Za-z0-9._+@/-]*) echo "неверный сеанс" >&2; exit 2 ;; esac
case $user in *[!a-z0-9_-]*) echo "неверное имя пользователя" >&2; exit 2 ;; esac
uid=$(getent passwd "$user" | cut -d: -f3)
[ -n "$uid" ] && [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || { echo "нет такого пользователя: $user" >&2; exit 2; }
dir=$(dirname "$file")
mkdir -p "$dir" || exit 1
tmp=$(mktemp "$dir/.autologin.XXXXXX") || exit 1
printf 'enabled = %s\nuser = "%s"\nsession = "%s"\n' "$enabled" "$user" "$session" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; exit 1; }
