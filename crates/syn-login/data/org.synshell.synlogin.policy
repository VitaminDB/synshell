<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>synshell</vendor>
  <action id="org.synshell.synlogin.autologin">
    <description>Configure automatic login</description>
    <description xml:lang="ru">Настройка автоматического входа</description>
    <message>Authentication is required to change automatic login</message>
    <message xml:lang="ru">Для изменения автоматического входа нужны права администратора</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/synlogin/autologin-helper</annotate>
  </action>
</policyconfig>
