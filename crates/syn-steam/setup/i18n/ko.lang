@tag = "ko"
@name = "한국어"

"{f}: другой файл — {got} байт, sha256 {sum} (в манифесте {size} байт, {want})" = "{f}: 다른 파일입니다 — {got}바이트, sha256 {sum} (매니페스트: {size}바이트, {want})"
"в архивах клиента нет {f}" = "클라이언트 압축 파일에 {f}이(가) 없습니다"
"{n} МБ" = "{n} MB"
"всего: {n} МБ" = "합계: {n} MB"
"syn-steam-setup [--root КАТАЛОГ] [--channel stable|publicbeta] [--no-window | --check | --manifest]" = "syn-steam-setup [--root 디렉터리] [--channel stable|publicbeta] [--no-window | --check | --manifest]"
"канал: stable | publicbeta" = "채널: stable | publicbeta"
"неизвестный ключ «{a}» (см. --help)" = "알 수 없는 옵션 “{a}” (--help 참조)"
"клиент уже поставлен: {r}" = "클라이언트가 이미 설치되어 있습니다: {r}"
