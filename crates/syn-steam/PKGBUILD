# Steam synshell — общий пакет для x86_64 и aarch64: свой запускатель /usr/bin/steam (Big Picture или обычный
# интерфейс, уже запущенный клиент — ссылкой steam://open/…), ярлыки, иконки и udev-правила из тарбола Valve.
# Клиента Valve в пакете нет (его нельзя распространять) — он ставит себя сам в каталог пользователя:
#   x86_64  — бутстрап-запускатель Valve (steam-launcher, как пакет steam Arch);
#   aarch64 — syn-steam-setup (setup/, крейт workspace synshell): при первом запуске скачивает нативный
#             aarch64-клиент по манифесту steam_client_linuxarm64 с CDN Valve (sha256 из манифеста), окно хода
#             загрузки; дальше клиент обновляет себя сам. Обходы ядер Android: эмуляция SysV IPC (LD_PRELOAD)
#             и setuid bwrap для pressure-vessel.
# Кросс-сборка aarch64 на x86_64-хосте: synmobile `synport hostpkg syn-steam` (CC, SYN_STEAM_MESON_CROSS,
# CARGO_BUILD_TARGET и линковщик cargo задаёт он).

pkgname=syn-steam
pkgver=1.0.0.87
pkgrel=3
_bwrapver=0.10.0
pkgdesc="Steam launcher for synshell: Valve's bootstrap on x86_64, first-run installer of the native ARM64 client on aarch64"
arch=(x86_64 aarch64)
url="https://store.steampowered.com/"
license=(LicenseRef-steam MIT)
depends=(
  bash coreutils curl dbus desktop-file-utils diffutils file freetype2 gdk-pixbuf2 glibc hicolor-icon-theme
  libgcc libxcrypt libxkbcommon-x11 lsb-release lsof nss pciutils procps-ng python usbutils
  vulkan-icd-loader xdg-user-dirs xdg-utils xorg-xrandr xz zenity udev
)
depends_x86_64=(
  libxcrypt-compat ttf-font vulkan-driver
  lib32-alsa-plugins lib32-fontconfig lib32-gcc-libs lib32-glibc lib32-libgl lib32-libgpg-error lib32-libnm
  lib32-libva lib32-libx11 lib32-libxcrypt lib32-libxcrypt-compat lib32-libxinerama lib32-libxss lib32-nss
  lib32-pipewire lib32-systemd lib32-vulkan-driver lib32-vulkan-icd-loader
)
depends_aarch64=(
  bubblewrap xorg-xwayland wayland-utils openbox xorg-xdpyinfo xorg-xrdb
  libgl mesa libdrm libva libvdpau systemd-libs libcap networkmanager
  glib2 gtk2 gtk3 ibus at-spi2-core libcups
  libogg libvorbis libvpx libsndfile openal libpipewire libpulse opus flac libsamplerate
  sdl2 libx11 libice libsm libxcomposite libxdamage libxinerama libxtst libxext libxfixes libxi
  libxrandr libxrender libxss libxcb libxcursor libxshmfence libxft libxt libxmu
  libxxf86vm wayland libdecor
)
makedepends_aarch64=(gcc meson ninja libcap cargo)
optdepends=(
  'syn-wine: Windows-игры системным Wine (compat tool «syn-wine»)'
  'ntsync-autoload: NTSync'
  'xdg-desktop-portal-impl: выбор файлов и папок'
)
provides=(steam steam-devices)
conflicts=(steam steam-devices steam-arm64)
replaces=(steam-arm64)
options=(!strip !debug !lto)
source=(
  "https://repo.steampowered.com/steam/archive/beta/steam_$pkgver.tar.gz"
  steam.sh
  steam-bigpicture.desktop
)
sha256sums=('649375d2f9377f8009aaf3e2ff09978041eb9114897d9c5a3886f1d82e27ba1f'
            SKIP
            SKIP)
source_aarch64=(
  sysv-shim.c
  openbox-rc.xml
  "https://github.com/containers/bubblewrap/releases/download/v$_bwrapver/bubblewrap-$_bwrapver.tar.xz"
)
sha256sums_aarch64=(
  SKIP
  SKIP
  '65d92cf44a63a51e1b7771f70c05013dce5bd6b0b2841c4b4be54b0c45565471'
)

build() {
  [[ $CARCH == aarch64 ]] || return 0

  # Ядро Android без SysV IPC (semget/shmget -> ENOSYS), а клиент Steam на нём
  # держит семафоры и разделяемую память: эмуляция через /dev/shm (LD_PRELOAD).
  # Та же эмуляция, что synmobile compat/x11/sysv-shim.c (обёртка Xwayland) — менять обе вместе.
  ${CC:-gcc} $CFLAGS -fPIC -shared $LDFLAGS -o libsysv-shim.so sysv-shim.c -lpthread

  # Ядро без SysV IPC отвергает CLONE_NEWIPC (EINVAL), изолировать там нечего:
  # --unshare-ipc делаем пустой операцией.
  sed -i 's/^  if (opt_unshare_ipc)$/  if (0 \&\& opt_unshare_ipc)/' "bubblewrap-$_bwrapver/bubblewrap.c"
  grep -q '(0 && opt_unshare_ipc)' "bubblewrap-$_bwrapver/bubblewrap.c"

  # Ядро без user namespaces, а bubblewrap >= 0.11 больше не работает setuid.
  # Контейнеру Steam (pressure-vessel, Proton) — отдельный setuid bwrap 0.10.0;
  # системный /usr/bin/bwrap не трогаем.
  arch-meson "bubblewrap-$_bwrapver" bwrap-build ${SYN_STEAM_MESON_CROSS:+--cross-file "$SYN_STEAM_MESON_CROSS"} \
    -D man=disabled -D bash_completion=disabled -D zsh_completion=disabled \
    -D selinux=disabled -D tests=false -D c_std=gnu17
  meson compile -C bwrap-build

  # первая установка клиента (окно хода загрузки) — крейт setup/ workspace synshell
  local ws prof=${SYN_STEAM_PROFILE:-release} pv
  ws=$(cd "$startdir/../.." && pwd)
  # без отладочных сведений (пакет не strip-ается: setuid bwrap и кросс-сборка)
  pv=${prof^^}; pv=${pv//-/_}
  export "CARGO_PROFILE_${pv}_DEBUG=false" "CARGO_PROFILE_${pv}_STRIP=symbols"
  cargo build --manifest-path "$ws/Cargo.toml" --profile "$prof" -p syn-steam-setup \
    --target-dir "${CARGO_TARGET_DIR:-$ws/target}"
  install -m755 "${CARGO_TARGET_DIR:-$ws/target}/${CARGO_BUILD_TARGET:+$CARGO_BUILD_TARGET/}$prof/syn-steam-setup" \
    "$srcdir/syn-steam-setup"
}

package() {
  local l="$srcdir/steam-launcher" s

  # общее: ярлыки, иконки, метаданные, udev-правила устройств (как steam-devices)
  install -Dm644 "$l/steam.desktop" "$pkgdir/usr/share/applications/steam.desktop"
  install -Dm644 "$srcdir/steam-bigpicture.desktop" "$pkgdir/usr/share/applications/steam-bigpicture.desktop"
  for s in 16 24 32 48 256; do
    install -Dm644 "$l/icons/$s/steam.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/steam.png"
  done
  install -Dm644 "$l/icons/48/steam.png" "$pkgdir/usr/share/pixmaps/steam.png"
  install -Dm644 "$l/icons/48/steam_tray_mono.png" "$pkgdir/usr/share/pixmaps/steam_tray_mono.png"
  install -Dm644 "$l/com.valvesoftware.Steam.metainfo.xml" "$pkgdir/usr/share/metainfo/com.valvesoftware.Steam.metainfo.xml"
  install -Dm644 "$l/steam.6" "$pkgdir/usr/share/man/man6/steam.6"
  install -Dm644 -t "$pkgdir/usr/share/doc/steam" "$l/README" "$l/steam_subscriber_agreement.txt"
  install -Dm644 "$l/steam_subscriber_agreement.txt" "$pkgdir/usr/share/licenses/$pkgname/steam_subscriber_agreement.txt"
  install -Dm644 "$l/subprojects/steam-devices/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/steam-devices.LICENSE"
  install -Dm644 -t "$pkgdir/usr/lib/udev/rules.d" \
    "$l/subprojects/steam-devices/60-steam-input.rules" "$l/subprojects/steam-devices/60-steam-vr.rules"

  if [[ $CARCH == aarch64 ]]; then
    _package_arm64
  else
    # x86_64: бутстрап Valve — /usr/lib/steam/bin_steam.sh распаковывает клиент в ~/.local/share/Steam
    make -C "$l" DESTDIR="$pkgdir" install-bin install-bootstrap
    rm -f "$pkgdir/usr/bin/steam" "$pkgdir/usr/bin/steamdeps" "$pkgdir/usr/lib/steam/bin_steamdeps.py"
  fi

  install -Dm755 "$srcdir/steam.sh" "$pkgdir/usr/bin/steam"
  # зависимости ставит pacman, не apt
  ln -s true "$pkgdir/usr/bin/steamdeps"
}

# aarch64: установщик клиента, шим, bwrap (сам клиент Valve ставит syn-steam-setup при первом запуске)
_package_arm64() {
  install -Dm755 "$srcdir/syn-steam-setup" "$pkgdir/usr/lib/syn-steam/syn-steam-setup"
  # прежнее имя запускателя
  install -d "$pkgdir/usr/bin"
  ln -s steam "$pkgdir/usr/bin/steam-arm64"
  install -Dm4755 "$srcdir/bwrap-build/bwrap" "$pkgdir/usr/lib/syn-steam/bwrap"
  install -Dm755 "$srcdir/libsysv-shim.so" "$pkgdir/usr/lib/syn-steam/libsysv-shim.so"
  install -Dm644 "$srcdir/openbox-rc.xml" "$pkgdir/usr/share/syn-steam/openbox-rc.xml"
}
