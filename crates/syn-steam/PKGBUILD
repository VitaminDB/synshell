noextract=($(printf '%s\n' "${source_aarch64[@]%%::*}" | grep '\.zip$'))

build() {
  [[ $CARCH == aarch64 ]] || return 0

  # Ядро Android без SysV IPC (semget/shmget -> ENOSYS), а клиент Steam на нём
  # держит семафоры и разделяемую память: эмуляция через /dev/shm (LD_PRELOAD).
  # Та же эмуляция, что synmobile compat/x11/sysv-shim.c (обёртка Xwayland) — менять обе вместе.
  gcc $CFLAGS -fPIC -shared $LDFLAGS -o libsysv-shim.so sysv-shim.c -lpthread

  # Ядро без SysV IPC отвергает CLONE_NEWIPC (EINVAL), изолировать там нечего:
  # --unshare-ipc делаем пустой операцией.
  sed -i 's/^  if (opt_unshare_ipc)$/  if (0 \&\& opt_unshare_ipc)/' "bubblewrap-$_bwrapver/bubblewrap.c"
  grep -q '(0 && opt_unshare_ipc)' "bubblewrap-$_bwrapver/bubblewrap.c"

  # Ядро без user namespaces, а bubblewrap >= 0.11 больше не работает setuid.
  # Контейнеру Steam (pressure-vessel, Proton) — отдельный setuid bwrap 0.10.0;
  # системный /usr/bin/bwrap не трогаем.
  arch-meson "bubblewrap-$_bwrapver" bwrap-build \
    -D man=disabled -D bash_completion=disabled -D zsh_completion=disabled \
    -D selinux=disabled -D tests=false -D c_std=gnu17
  meson compile -C bwrap-build
}

package() {
  local l="$srcdir/steam-launcher" s

  # общее: ярлыки, иконки, метаданные, udev-правила устройств (как steam-devices)
  install -Dm644 "$l/steam.desktop" "$pkgdir/usr/share/applications/steam.desktop"
  install -Dm644 "$srcdir/steam-bigpicture.desktop" "$pkgdir/usr/share/applications/steam-bigpicture.desktop"
  for s in 16 24 32 48 256; do
    install -Dm644 "$l/icons/$s/steam.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/steam.png"
  done
  install -Dm644 "$l/icons/48/steam.png" "$pkgdir/usr/share/pixmaps/steam.png"
  install -Dm644 "$l/icons/48/steam_tray_mono.png" "$pkgdir/usr/share/pixmaps/steam_tray_mono.png"
  install -Dm644 "$l/com.valvesoftware.Steam.metainfo.xml" "$pkgdir/usr/share/metainfo/com.valvesoftware.Steam.metainfo.xml"
  install -Dm644 "$l/steam.6" "$pkgdir/usr/share/man/man6/steam.6"
  install -Dm644 -t "$pkgdir/usr/share/doc/steam" "$l/README" "$l/steam_subscriber_agreement.txt"
  install -Dm644 "$l/steam_subscriber_agreement.txt" "$pkgdir/usr/share/licenses/$pkgname/steam_subscriber_agreement.txt"
  install -Dm644 "$l/subprojects/steam-devices/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/steam-devices.LICENSE"
  install -Dm644 -t "$pkgdir/usr/lib/udev/rules.d" \
    "$l/subprojects/steam-devices/60-steam-input.rules" "$l/subprojects/steam-devices/60-steam-vr.rules"

  if [[ $CARCH == aarch64 ]]; then
    _package_arm64
  else
    # x86_64: бутстрап Valve — /usr/lib/steam/bin_steam.sh распаковывает клиент в ~/.local/share/Steam
    make -C "$l" DESTDIR="$pkgdir" install-bin install-bootstrap
    rm -f "$pkgdir/usr/bin/steam" "$pkgdir/usr/bin/steamdeps" "$pkgdir/usr/lib/steam/bin_steamdeps.py"
  fi

  install -Dm755 "$srcdir/steam.sh" "$pkgdir/usr/bin/steam"
  # зависимости ставит pacman, не apt
  ln -s true "$pkgdir/usr/bin/steamdeps"
}

# aarch64: начальная копия нативного клиента (запускатель копирует её в каталог пользователя), шим, bwrap
_package_arm64() {
  local dest="$pkgdir/usr/lib/syn-steam/client" z e t

  mkdir -p "$dest"
  for z in "${source_aarch64[@]%%::*}"; do
    [[ $z == *.zip ]] && bsdtar -xf "$srcdir/$z" -C "$dest"
  done

  # в архивах Valve пути вида "dir\sub\file" — превращаем в каталоги
  while IFS= read -r -d '' e; do
    t="$dest/$(basename "$e" | tr '\\' '/')"
    if [[ -d $e ]]; then
      mkdir -p "$t"
      cp -a "$e/." "$t/"
      rm -rf "$e"
    else
      mkdir -p "$(dirname "$t")"
      mv "$e" "$t"
    fi
  done < <(find "$dest" -mindepth 1 -maxdepth 1 -name '*\\*' -print0 | sort -z)

  # права на исполнение для ELF и скриптов
  while IFS= read -r -d '' e; do
    case "$(head -c 4 "$e" | od -An -tx1 | tr -d ' \n')" in
      7f454c46 | 2321*) chmod 755 "$e" ;;
    esac
  done < <(find "$dest" -type f -print0)
  test -x "$dest/steamrtarm64/steam"

  # прежнее имя запускателя
  install -d "$pkgdir/usr/bin"
  ln -s steam "$pkgdir/usr/bin/steam-arm64"
  install -Dm4755 "$srcdir/bwrap-build/bwrap" "$pkgdir/usr/lib/syn-steam/bwrap"
  install -Dm755 "$srcdir/libsysv-shim.so" "$pkgdir/usr/lib/syn-steam/libsysv-shim.so"
  install -Dm644 "$srcdir/openbox-rc.xml" "$pkgdir/usr/share/syn-steam/openbox-rc.xml"
}
