/* Терминал: моноширинный шрифт и зелёное свечение. */
Text, TextField, Button { font-family: "Hack"; }
.page-title { color: var(--phosphor); text-shadow: 0 0 8px var(--phosphor-glow); text-transform: uppercase; }
.group-title { color: var(--phosphor); text-transform: uppercase; }
.group-card { border-radius: 0px; border-color: var(--border); }
.nav-item { border-radius: 0px; }
.nav-item.active { background: var(--phosphor); }
.nav-item.active .nav-label, .nav-item.active .nav-icon { color: #021005; }
.brand-logo { border-radius: 0px; }
Button, TextField, Dropdown, Autocomplete, SpinBox, SegmentedButton { border-radius: 0px; }
.theme-card { border-radius: 0px; }
.theme-thumb, .theme-wall { border-radius: 0px; }
