/* Необрутализм: рамки и жёсткие тени у карточек и кнопок. */
.sidebar { border-right: 2px solid var(--border); }
.group-card { border: 2px solid var(--border); border-radius: 0px; box-shadow: 5px 5px 0 var(--hard); }
.row-sep { background: var(--border); }
.nav-item { border-radius: 0px; }
.nav-item.active { background: var(--pop); border: 2px solid var(--border); }
.nav-item.active .nav-label, .nav-item.active .nav-icon { color: #111111; }
.page-title { font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
.group-title { text-transform: uppercase; letter-spacing: 1px; }
.brand-logo { border-radius: 0px; border: 2px solid var(--border); box-shadow: 3px 3px 0 var(--hard); }
Button { border: 2px solid var(--border); border-radius: 0px; box-shadow: 3px 3px 0 var(--hard); }
Button.icon-btn { border: 0px solid transparent; box-shadow: none; }
TextField, Dropdown, Autocomplete, SpinBox, SegmentedButton { border: 2px solid var(--border); border-radius: 0px; }
.theme-card { border-radius: 0px; box-shadow: 4px 4px 0 var(--hard); }
.theme-thumb, .theme-wall { border-radius: 0px; }
