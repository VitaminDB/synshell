/* Аврора: стеклянные карточки над сиянием. */
.sidebar { background: var(--panel-bg); border-right: 1px solid var(--glass-edge); }
.group-card { border: 1px solid var(--glass-edge); box-shadow: inset 0 1px 0 var(--glass-hi), 0 8px 24px var(--shadow); }
.brand-logo { background: linear-gradient(135deg, var(--accent), var(--violet)); }
