/* Tokyo Night: неоновая рамка активных элементов. */
.nav-item.active { border: 1px solid var(--neon); }
.nav-item.active .nav-icon { color: var(--magenta); }
.brand-logo { background: linear-gradient(135deg, var(--accent), var(--magenta)); }
Button.primary { glow: 0 0 10px var(--neon); }
.page-title { color: var(--accent); }
