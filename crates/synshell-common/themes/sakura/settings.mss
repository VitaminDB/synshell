/* Сакура: округлые карточки с розовой тенью. */
.group-card { border-radius: 18px; box-shadow: 0 6px 18px var(--shadow); }
.nav-item { border-radius: 14px; }
Button { border-radius: 14px; }
TextField, Dropdown, Autocomplete, SpinBox, SegmentedButton { border-radius: 12px; }
.page-title { color: var(--petal); }
.brand-logo { border-radius: 17px; }
