# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PAKIET|DLL… [--arch x86|x64] | remove PAKIET… | scan PROGRAM.exe | run PROGRAM.exe [ARG…] | probe PLIK]"
"неизвестная команда «{c}» (см. --help)" = "nieznane polecenie „{c}” (zob. --help)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "moduły GStreamer dla {w}: odpowiednie pakiety są już zainstalowane"
"Каталог DLL: {d}" = "Katalog DLL: {d}"
"нет пакета или DLL «{n}»" = "brak pakietu lub DLL „{n}”"
"что поставить? (syn-wine-helper list)" = "co zainstalować? (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: usunięto plików — {n}"
"какую программу проверить?" = "który program sprawdzić?"
"{exe} ({arch}): всех DLL хватает" = "{exe} ({arch}): niczego nie brakuje"
"пакет {id}" = "pakiet {id}"
"в базе нет" = "brak w bazie"
"какую программу запустить?" = "który program uruchomić?"

