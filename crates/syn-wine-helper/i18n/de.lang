# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PAKET|DLL… [--arch x86|x64] | remove PAKET… | scan PROGRAMM.exe | run PROGRAMM.exe [ARG…] | probe DATEI]"
