# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PAQUETE|DLL… [--arch x86|x64] | remove PAQUETE… | scan PROGRAMA.exe | run PROGRAMA.exe [ARG…] | probe ARCHIVO]"
"неизвестная команда «{c}» (см. --help)" = "orden desconocida «{c}» (ver --help)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "módulos de GStreamer para {w}: los paquetes adecuados ya están instalados"
"Каталог DLL: {d}" = "Carpeta de DLL: {d}"
"нет пакета или DLL «{n}»" = "no existe el paquete o DLL «{n}»"
"что поставить? (syn-wine-helper list)" = "¿qué instalar? (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: archivos eliminados: {n}"
"какую программу проверить?" = "¿qué programa comprobar?"
"{exe} ({arch}): всех DLL хватает" = "{exe} ({arch}): no falta ninguna DLL"
"пакет {id}" = "paquete {id}"
"в базе нет" = "no está en la base"
"какую программу запустить?" = "¿qué programa ejecutar?"

# src/scan.rs
"{f}: не PE-файл" = "{f}: no es un archivo PE"
