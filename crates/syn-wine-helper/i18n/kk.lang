@tag = "kk"
@name = "Қазақша"

# src/fetch.rs
"другой файл: {got} байт, sha256 {sum}" = "басқа файл: {got} байт, sha256 {sum}"

# src/gst.rs
"Основные форматы: AVI, MKV, MP4/MOV, FLAC, VP8/VP9" = "Негізгі пішімдер: AVI, MKV, MP4/MOV, FLAC, VP8/VP9"
"ASF/WMV-контейнер, MPEG-1/2, AC-3 — форматы с лицензионными ограничениями" = "ASF/WMV контейнері, MPEG-1/2, AC-3 — лицензиялық шектеулері бар пішімдер"
"Новые и редкие форматы: AV1, MPEG-TS, HEVC и другие" = "Жаңа және сирек пішімдер: AV1, MPEG-TS, HEVC және басқалар"
"Кодеки FFmpeg: WMV, WMA, H.264, MPEG-4, AAC, Indeo, Cinepak и другие" = "FFmpeg кодектері: WMV, WMA, H.264, MPEG-4, AAC, Indeo, Cinepak және басқалар"
"Базовые модули: Ogg, Vorbis, Theora, Opus, преобразование видео и звука" = "Негізгі модульдер: Ogg, Vorbis, Theora, Opus, бейне мен дыбысты түрлендіру"

# src/install.rs
"нет пакета «{id}»" = "«{id}» пакеті жоқ"
"у пакета «{id}» нет варианта {arch}" = "«{id}» пакетінің {arch} нұсқасы жоқ"
"в базе нет источника «{s}»" = "базада «{s}» дереккөзі жоқ"
"{name}: скачивание {file}{step}" = "{name}: {file} жүктеп алу{step}"
"{name}: скачивание {got} из {total} МБ{step}" = "{name}: жүктеп алу {got} / {total} МБ{step}"
"не удалось скачать {file}" = "{file} жүктеп алынбады"
"{name}: распаковка{step}" = "{name}: ашу{step}"
"в {file} нет {dll} ({arch})" = "{file} ішінде {dll} жоқ ({arch})"

# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan БАҒДАРЛАМА.exe | run БАҒДАРЛАМА.exe [АРГ…] | probe ФАЙЛ]"
"неизвестная команда «{c}» (см. --help)" = "белгісіз команда «{c}» (--help қараңыз)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "{w} үшін GStreamer модульдері: сәйкес пакеттер орнатылған"
"Каталог DLL: {d}" = "DLL каталогы: {d}"
"нет пакета или DLL «{n}»" = "«{n}» пакеті немесе DLL-і жоқ"
"что поставить? (syn-wine-helper list)" = "не орнату керек? (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: жойылған файлдар — {n}"
"какую программу проверить?" = "қай бағдарламаны тексеру керек?"
"{exe} ({arch}): всех DLL хватает" = "{exe} ({arch}): барлық DLL жеткілікті"
"пакет {id}" = "{id} пакеті"
"в базе нет" = "базада жоқ"
"какую программу запустить?" = "қай бағдарламаны іске қосу керек?"

# src/scan.rs
"{f}: не PE-файл" = "{f}: PE-файл емес"
"{f}: машина {m:04x} — не x86 и не x64" = "{f}: {m:04x} машинасы — x86 те, x64 те емес"

# src/ui/ask.rs
"Компоненты установлены. Закройте программу и запустите её снова." = "Компоненттер орнатылды. Бағдарламаны жабып, қайта іске қосыңыз."
"Готово. Запустите игру снова из Steam." = "Дайын. Ойынды Steam-нен қайта іске қосыңыз."
"установлено, но программа не запустилась: {e}" = "орнатылды, бірақ бағдарлама іске қосылмады: {e}"
"Этого нет ни в Wine, ни в базе компонентов. Обычно такие библиотеки лежат рядом с программой — проверьте, что она скопирована целиком." = "Бұл Wine-да да, компоненттер базасында да жоқ. Әдетте мұндай кітапханалар бағдарламаның жанында жатады — оның толық көшірілгенін тексеріңіз."
"Не хватает компонентов" = "Компоненттер жетіспейді"
"Программе «{p}» нужны библиотеки, которых нет в Wine." = "«{p}» бағдарламасына Wine-да жоқ кітапханалар қажет."
"Эти библиотеки уже поставлены, но Wine их не нашёл. Нужен Wine с поддержкой общего каталога компонентов (патч syn-wine-helper)." = "Бұл кітапханалар орнатылған, бірақ Wine оларды таппады. Ортақ компоненттер каталогын қолдайтын Wine қажет (syn-wine-helper түзетуі)."
"Скачать {s} — один раз: компоненты ставятся для всех программ." = "{s} жүктеп алу — бір рет: компоненттер барлық бағдарламаларға орнатылады."
"Файлы уже скачаны: компоненты ставятся для всех программ." = "Файлдар жүктеп алынған: компоненттер барлық бағдарламаларға орнатылады."
"Закрыть" = "Жабу"
"Отмена" = "Бас тарту"
"Запустить так" = "Осылай іске қосу"
"Повторить" = "Қайталау"
"Установить" = "Орнату"
"Установить и запустить" = "Орнату және іске қосу"

# src/ui/gst.rs
"Установка {p}…" = "{p} орнатылуда…"
"Модули установлены. Перезапустите программу, чтобы видео и звук заработали." = "Модульдер орнатылды. Бейне мен дыбыс жұмыс істеуі үшін бағдарламаны қайта іске қосыңыз."
"программа" = "бағдарлама"
"Нечем воспроизвести видео" = "Бейнені ойнататын ештеңе жоқ"
"«{p}» не может открыть видео или звук: в системе нет модулей GStreamer для этого формата." = "«{p}» бейнені немесе дыбысты аша алмайды: жүйеде бұл пішімге арналған GStreamer модульдері жоқ."
"Формат: {f}" = "Пішім: {f}"
"Пакеты ставятся в систему из репозиториев (pacman) и нужны всем программам Wine. Понадобится пароль администратора." = "Пакеттер жүйеге репозиторийлерден (pacman) орнатылады және Wine-дың барлық бағдарламаларына қажет. Әкімші құпиясөзі қажет болады."

# src/ui/list.rs
"Компоненты Wine" = "Wine компоненттері"
"Библиотеки, которых нет в самом Wine. Ставятся один раз — для всех программ и префиксов; когда программе чего-то не хватит, Wine предложит поставить сам." = "Wine-дың өзінде жоқ кітапханалар. Бір рет орнатылады — барлық бағдарламалар мен префикстер үшін; бағдарламаға бірдеңе жетіспесе, Wine өзі орнатуды ұсынады."
"Каталог: {d}" = "Каталог: {d}"

# src/ui/mod.rs
"Подготовка…" = "Дайындау…"
"{n} МБ" = "{n} МБ"
"Не получилось: {e}" = "Болмады: {e}"
"Модули видео и звука" = "Бейне және дыбыс модульдері"
