@tag = "tr"
@name = "Türkçe"

# src/fetch.rs
"другой файл: {got} байт, sha256 {sum}" = "farklı bir dosya: {got} bayt, sha256 {sum}"

# src/gst.rs
"Основные форматы: AVI, MKV, MP4/MOV, FLAC, VP8/VP9" = "Temel biçimler: AVI, MKV, MP4/MOV, FLAC, VP8/VP9"
