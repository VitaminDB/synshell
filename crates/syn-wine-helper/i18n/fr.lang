# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PAQUET|DLL… [--arch x86|x64] | remove PAQUET… | scan PROGRAMME.exe | run PROGRAMME.exe [ARG…] | probe FICHIER]"
