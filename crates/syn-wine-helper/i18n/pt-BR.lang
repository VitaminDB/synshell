# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PACOTE|DLL… [--arch x86|x64] | remove PACOTE… | scan PROGRAMA.exe | run PROGRAMA.exe [ARG…] | probe ARQUIVO]"
"неизвестная команда «{c}» (см. --help)" = "comando desconhecido “{c}” (veja --help)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "módulos GStreamer para {w}: os pacotes adequados já estão instalados"
"Каталог DLL: {d}" = "Pasta de DLLs: {d}"
"нет пакета или DLL «{n}»" = "não há pacote ou DLL “{n}”"
"что поставить? (syn-wine-helper list)" = "o que instalar? (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: arquivos removidos — {n}"
"какую программу проверить?" = "qual programa verificar?"
"{exe} ({arch}): всех DLL хватает" = "{exe} ({arch}): não falta nenhuma DLL"
"пакет {id}" = "pacote {id}"
"в базе нет" = "não está no banco de dados"
"какую программу запустить?" = "qual programa executar?"

# src/scan.rs
"{f}: не PE-файл" = "{f}: não é um arquivo PE"
