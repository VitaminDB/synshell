# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install ПАКУНОК|DLL… [--arch x86|x64] | remove ПАКУНОК… | scan ПРОГРАМА.exe | run ПРОГРАМА.exe [АРГ…] | probe ФАЙЛ]"
