"пакет {id}" = "пакунок {id}"
"в базе нет" = "немає в базі"
"какую программу запустить?" = "яку програму запустити?"

# src/scan.rs
"{f}: не PE-файл" = "{f}: не PE-файл"
"{f}: машина {m:04x} — не x86 и не x64" = "{f}: машина {m:04x} — не x86 і не x64"

# src/ui/ask.rs
"Компоненты установлены. Закройте программу и запустите её снова." = "Компоненти встановлено. Закрийте програму й запустіть її знову."
