@tag = "ko"
@name = "한국어"

# src/fetch.rs
"другой файл: {got} байт, sha256 {sum}" = "다른 파일: {got}바이트, sha256 {sum}"

# src/gst.rs
"Основные форматы: AVI, MKV, MP4/MOV, FLAC, VP8/VP9" = "주요 형식: AVI, MKV, MP4/MOV, FLAC, VP8/VP9"
"ASF/WMV-контейнер, MPEG-1/2, AC-3 — форматы с лицензионными ограничениями" = "ASF/WMV 컨테이너, MPEG-1/2, AC-3 — 라이선스 제한이 있는 형식"
"Новые и редкие форматы: AV1, MPEG-TS, HEVC и другие" = "새롭거나 드문 형식: AV1, MPEG-TS, HEVC 등"
"Кодеки FFmpeg: WMV, WMA, H.264, MPEG-4, AAC, Indeo, Cinepak и другие" = "FFmpeg 코덱: WMV, WMA, H.264, MPEG-4, AAC, Indeo, Cinepak 등"
"Базовые модули: Ogg, Vorbis, Theora, Opus, преобразование видео и звука" = "기본 모듈: Ogg, Vorbis, Theora, Opus, 동영상 및 오디오 변환"

# src/install.rs
"нет пакета «{id}»" = "패키지 “{id}” 없음"
"у пакета «{id}» нет варианта {arch}" = "패키지 “{id}”에 {arch} 버전이 없습니다"
"в базе нет источника «{s}»" = "데이터베이스에 소스 “{s}”이(가) 없습니다"
"{name}: скачивание {file}{step}" = "{name}: {file} 다운로드 중{step}"
"{name}: скачивание {got} из {total} МБ{step}" = "{name}: {total}MB 중 {got}MB 다운로드 중{step}"
"не удалось скачать {file}" = "{file}을(를) 다운로드할 수 없습니다"
"{name}: распаковка{step}" = "{name}: 압축 해제 중{step}"
"в {file} нет {dll} ({arch})" = "{file}에 {dll}({arch})이(가) 없습니다"

# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install 패키지|DLL… [--arch x86|x64] | remove 패키지… | scan 프로그램.exe | run 프로그램.exe [인수…] | probe 파일]"
"неизвестная команда «{c}» (см. --help)" = "알 수 없는 명령 “{c}”(--help 참조)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "{w}용 GStreamer 모듈: 해당 패키지가 이미 설치되어 있습니다"
"Каталог DLL: {d}" = "DLL 디렉터리: {d}"
"нет пакета или DLL «{n}»" = "패키지 또는 DLL “{n}” 없음"
"что поставить? (syn-wine-helper list)" = "무엇을 설치할까요? (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: 삭제된 파일 — {n}개"
"какую программу проверить?" = "어떤 프로그램을 확인할까요?"
"{exe} ({arch}): всех DLL хватает" = "{exe}({arch}): 빠진 DLL이 없습니다"
"пакет {id}" = "패키지 {id}"
"в базе нет" = "데이터베이스에 없음"
"какую программу запустить?" = "어떤 프로그램을 실행할까요?"

# src/scan.rs
"{f}: не PE-файл" = "{f}: PE 파일이 아닙니다"
"{f}: машина {m:04x} — не x86 и не x64" = "{f}: 머신 {m:04x} — x86도 x64도 아닙니다"

# src/ui/ask.rs
"Компоненты установлены. Закройте программу и запустите её снова." = "구성 요소가 설치되었습니다. 프로그램을 닫고 다시 실행하세요."
"Готово. Запустите игру снова из Steam." = "완료. Steam에서 게임을 다시 실행하세요."
"установлено, но программа не запустилась: {e}" = "설치했지만 프로그램이 실행되지 않았습니다: {e}"
"Этого нет ни в Wine, ни в базе компонентов. Обычно такие библиотеки лежат рядом с программой — проверьте, что она скопирована целиком." = "Wine에도 구성 요소 데이터베이스에도 없습니다. 이런 라이브러리는 보통 프로그램과 함께 있으니 프로그램이 모두 복사되었는지 확인하세요."
"Не хватает компонентов" = "구성 요소 부족"
"Программе «{p}» нужны библиотеки, которых нет в Wine." = "“{p}”에 Wine에 없는 라이브러리가 필요합니다."
"Эти библиотеки уже поставлены, но Wine их не нашёл. Нужен Wine с поддержкой общего каталога компонентов (патч syn-wine-helper)." = "이 라이브러리는 이미 설치되었지만 Wine이 찾지 못했습니다. 공유 구성 요소 디렉터리를 지원하는 Wine(syn-wine-helper 패치)이 필요합니다."
"Скачать {s} — один раз: компоненты ставятся для всех программ." = "{s} 한 번만 다운로드: 구성 요소는 모든 프로그램용으로 설치됩니다."
"Файлы уже скачаны: компоненты ставятся для всех программ." = "파일이 이미 다운로드되었습니다: 구성 요소는 모든 프로그램용으로 설치됩니다."
"Закрыть" = "닫기"
"Отмена" = "취소"
"Запустить так" = "그대로 실행"
"Повторить" = "다시 시도"
"Установить" = "설치"
"Установить и запустить" = "설치 후 실행"

# src/ui/gst.rs
"Установка {p}…" = "{p} 설치 중…"
"Модули установлены. Перезапустите программу, чтобы видео и звук заработали." = "모듈이 설치되었습니다. 동영상과 소리가 작동하도록 프로그램을 다시 시작하세요."
"программа" = "프로그램"
"Нечем воспроизвести видео" = "동영상을 재생할 수 없음"
"«{p}» не может открыть видео или звук: в системе нет модулей GStreamer для этого формата." = "“{p}”이(가) 동영상이나 소리를 열 수 없습니다: 시스템에 이 형식용 GStreamer 모듈이 없습니다."
"Формат: {f}" = "형식: {f}"
"Пакеты ставятся в систему из репозиториев (pacman) и нужны всем программам Wine. Понадобится пароль администратора." = "패키지는 저장소에서 시스템 전체에 설치되며(pacman) 모든 Wine 프로그램에 사용됩니다. 관리자 암호가 필요합니다."

# src/ui/list.rs
"Компоненты Wine" = "Wine 구성 요소"
"Библиотеки, которых нет в самом Wine. Ставятся один раз — для всех программ и префиксов; когда программе чего-то не хватит, Wine предложит поставить сам." = "Wine 자체에 없는 라이브러리. 모든 프로그램과 접두사(prefix)용으로 한 번만 설치하며, 프로그램에 무언가 부족하면 Wine이 직접 설치를 제안합니다."
"Каталог: {d}" = "디렉터리: {d}"

# src/ui/mod.rs
"Подготовка…" = "준비 중…"
"{n} МБ" = "{n}MB"
"Не получилось: {e}" = "실패: {e}"
"Модули видео и звука" = "동영상 및 소리 모듈"
"Нужны компоненты Wine" = "Wine 구성 요소 필요"
