# src/install.rs
"нет пакета «{id}»" = "パッケージ「{id}」がありません"
"у пакета «{id}» нет варианта {arch}" = "パッケージ「{id}」に {arch} 版はありません"
"в базе нет источника «{s}»" = "ソース「{s}」はデータベースにありません"
