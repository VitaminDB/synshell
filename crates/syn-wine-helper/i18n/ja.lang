# src/main.rs
"syn-wine-helper [list | install ПАКЕТ|DLL… [--arch x86|x64] | remove ПАКЕТ… | scan ПРОГРАММА.exe | run ПРОГРАММА.exe [АРГ…] | probe ФАЙЛ]" = "syn-wine-helper [list | install PACKAGE|DLL… [--arch x86|x64] | remove PACKAGE… | scan PROGRAM.exe | run PROGRAM.exe [ARG…] | probe FILE]"
"неизвестная команда «{c}» (см. --help)" = "不明なコマンド「{c}」(--help を参照)"
"модули GStreamer для {w}: подходящие пакеты уже установлены" = "{w} 用 GStreamer モジュール: 該当するパッケージはインストール済みです"
"Каталог DLL: {d}" = "DLL ディレクトリ: {d}"
"нет пакета или DLL «{n}»" = "パッケージまたは DLL「{n}」がありません"
"что поставить? (syn-wine-helper list)" = "何をインストールしますか？ (syn-wine-helper list)"
"{id}: удалено файлов — {n}" = "{id}: ファイルを削除しました — {n}"
"какую программу проверить?" = "どのプログラムを確認しますか？"
"{exe} ({arch}): всех DLL хватает" = "{exe} ({arch}): 不足している DLL はありません"
"пакет {id}" = "パッケージ {id}"
"в базе нет" = "データベースにありません"
"какую программу запустить?" = "どのプログラムを実行しますか？"

# src/scan.rs
"{f}: не PE-файл" = "{f}: PE ファイルではありません"
"{f}: машина {m:04x} — не x86 и не x64" = "{f}: マシン {m:04x} は x86 でも x64 でもありません"

# src/ui/ask.rs
"Компоненты установлены. Закройте программу и запустите её снова." = "コンポーネントをインストールしました。プログラムを閉じて再起動してください。"
"Готово. Запустите игру снова из Steam." = "完了しました。Steam からゲームを再起動してください。"
"установлено, но программа не запустилась: {e}" = "インストールしましたが、プログラムが起動しませんでした: {e}"
"Этого нет ни в Wine, ни в базе компонентов. Обычно такие библиотеки лежат рядом с программой — проверьте, что она скопирована целиком." = "Wine にもコンポーネントデータベースにもありません。このようなライブラリは通常プログラムに同梱されています — 完全にコピーされたか確認してください。"
"Не хватает компонентов" = "不足しているコンポーネント"
"Программе «{p}» нужны библиотеки, которых нет в Wine." = "「{p}」には Wine にないライブラリが必要です。"
"Эти библиотеки уже поставлены, но Wine их не нашёл. Нужен Wine с поддержкой общего каталога компонентов (патч syn-wine-helper)." = "これらのライブラリはインストール済みですが、Wine が見つけられませんでした。共有コンポーネントディレクトリに対応した Wine (syn-wine-helper の修正) が必要です。"
"Скачать {s} — один раз: компоненты ставятся для всех программ." = "{s} を一度ダウンロードしてください: コンポーネントはすべてのプログラム用にインストールされます。"
"Файлы уже скачаны: компоненты ставятся для всех программ." = "ファイルはダウンロード済みです: コンポーネントはすべてのプログラム用にインストールされます。"
"Закрыть" = "閉じる"
"Отмена" = "キャンセル"
"Запустить так" = "このまま実行"
"Повторить" = "再試行"
"Установить" = "インストール"
"Установить и запустить" = "インストールして実行"

# src/ui/gst.rs
"Установка {p}…" = "{p} をインストール中…"
"Модули установлены. Перезапустите программу, чтобы видео и звук заработали." = "モジュールをインストールしました。動画と音声を有効にするにはプログラムを再起動してください。"
"программа" = "このプログラム"
"Нечем воспроизвести видео" = "動画を再生できません"
"«{p}» не может открыть видео или звук: в системе нет модулей GStreamer для этого формата." = "「{p}」は動画または音声を開けません: システムにこの形式用の GStreamer モジュールがありません。"
"Формат: {f}" = "形式: {f}"
"Пакеты ставятся в систему из репозиториев (pacman) и нужны всем программам Wine. Понадобится пароль администратора." = "パッケージはリポジトリ (pacman) からシステム全体にインストールされ、すべての Wine プログラムで使われます。管理者パスワードが必要です。"

