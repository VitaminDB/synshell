<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Syn Blocks"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="true"
        android:isGame="true"
        android:theme="@style/Theme.SynBlocks">

        <activity
            android:name="com.syngui.synblocks.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">

            <meta-data
                android:name="android.app.lib_name"
                android:value="syn_blocks" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
