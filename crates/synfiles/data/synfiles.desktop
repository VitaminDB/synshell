[Desktop Entry]
Type=Application
Name=Files
Name[ru]=Проводник
GenericName=File Manager
GenericName[ru]=Файловый менеджер
Comment=Browse and manage files
Comment[ru]=Файлы и папки: вкладки, две панели, поиск, корзина
Exec=synfiles %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Utility;Core;
MimeType=inode/directory;
Keywords=files;folders;explorer;file manager;browser;
Keywords[ru]=файлы;папки;проводник;файловый менеджер;
StartupNotify=true
StartupWMClass=synfiles
