.root { background-color: var(--bg); }
.grow { flex-grow: 1; }
.ic { icon-size: 20px; icon-color: var(--muted); }
.sidebar { width: 280px; padding: 14px 10px; background-color: var(--surface-alt); }
.brand { width: 34px; height: 34px; border-radius: 10px; background-color: var(--accent); justify-content: center; align-items: center; }
.brand-ic { icon-color: var(--accent-fg); icon-size: 20px; }
.brand-title { font-size: 17px; font-weight: 600; color: var(--fg); }
.btn { padding: 8px 12px; border-radius: 10px; background-color: var(--surface); color: var(--fg); font-size: 13px; }
.btn:hover { background-color: var(--hover); }
.btn.primary { background-color: var(--accent); color: var(--accent-fg); }
.btn.new { padding: 10px 12px; }
.btn.round { padding: 8px; border-radius: 999px; }
.btn.flat { background-color: #00000000; }
.btn.small { padding: 4px; icon-size: 16px; }
.btn.send { background-color: var(--accent); color: var(--accent-fg); }
.btn.stop { background-color: var(--danger); color: #ffffff; }
.btn.chip { padding: 6px 10px; border-radius: 999px; font-size: 12px; }
.btn.chip.on { background-color: var(--accent); color: var(--accent-fg); }
.btn.example { padding: 10px 16px; border-radius: 14px; font-size: 13px; }
.btn.att { font-size: 12px; }
.chat-item { padding: 8px 10px; border-radius: 10px; }
.chat-item:hover { background-color: var(--hover); }
.chat-item.active { background-color: var(--surface); }
.chat-title { font-size: 13px; color: var(--fg); }
.chat-preview { font-size: 11px; color: var(--muted); }
.hint { font-size: 12px; color: var(--muted); }
.pad { padding: 10px; }
.pane { background-color: var(--bg); }
.header { padding: 10px 16px; }
.title { font-size: 15px; font-weight: 600; color: var(--fg); }
.feed-pad { padding: 8px 20px 20px 20px; }
.user-bubble { padding: 10px 14px; border-radius: 16px; background-color: var(--accent); max-width: 620px; }
.user-text { color: var(--accent-fg); font-size: 14px; }
.assistant { max-width: 760px; }
.answer { font-size: 14px; color: var(--fg); }
.think { padding: 8px 10px; border-radius: 10px; background-color: var(--surface-alt); }
.think-ic { icon-size: 16px; }
.think-head { font-size: 12px; color: var(--muted); }
.think-body { font-size: 12px; color: var(--muted); }
.tool-card { padding: 8px 12px; border-radius: 12px; background-color: var(--surface); max-width: 760px; }
.tool-card.failed { background-color: var(--danger-soft); }
.tool-ic { icon-size: 18px; icon-color: var(--accent); }
.tool-ic.fail { icon-color: var(--danger); }
.tool-ok { icon-size: 16px; icon-color: var(--accent); }
.tool-fail { icon-size: 16px; icon-color: var(--danger); }
.tool-sum { font-size: 13px; color: var(--fg); }
.tool-out { font-size: 12px; color: var(--muted); font-family: monospace; }
.att-image { max-width: 420px; max-height: 420px; border-radius: 10px; }
.typing { font-size: 20px; color: var(--muted); }
.spin { width: 16px; height: 16px; }
.error { font-size: 13px; color: var(--danger); }
.confirm { margin: 0px 16px 8px 16px; padding: 10px 14px; border-radius: 14px; background-color: var(--surface); border: 1px solid var(--accent); }
.confirm-ic { icon-size: 22px; icon-color: var(--accent); }
.confirm-title { font-size: 13px; font-weight: 600; color: var(--fg); }
.confirm-sum { font-size: 12px; color: var(--fg); font-family: monospace; }
.input-bar { padding: 8px 16px 16px 16px; }
MultilineTextEdit.input { background-color: var(--surface); color: var(--fg); border: 1px solid var(--border); border-radius: 16px; padding: 10px 14px; font-size: 14px; }
.empty { padding: 72px 24px 24px 24px; }
.hero { width: 64px; height: 64px; border-radius: 20px; background-color: var(--accent); justify-content: center; align-items: center; }
.hero-ic { icon-size: 36px; icon-color: var(--accent-fg); }
.hero-title { font-size: 24px; font-weight: 600; color: var(--fg); }
.hero-sub { font-size: 13px; color: var(--muted); max-width: 460px; text-align: center; }
