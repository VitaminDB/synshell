[Desktop Entry]
Type=Application
Name=Image Viewer
Name[ru]=Просмотр изображений
GenericName=Image Viewer
GenericName[ru]=Просмотр изображений
Comment=View images: zoom, rotate, browse a folder
Comment[ru]=Картинки: масштаб, поворот, листание папки, HEIC и EXIF
Exec=syndesktop-files --viewer %f
Icon=image-x-generic
Terminal=false
NoDisplay=false
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/x-bmp;image/webp;image/svg+xml;image/tiff;image/heic;image/heif;image/avif;image/x-icon;image/vnd.microsoft.icon;image/jxl;image/x-portable-pixmap;image/x-tga;
Keywords=image;photo;picture;viewer;
Keywords[ru]=картинка;фото;изображение;просмотр;
StartupNotify=true
StartupWMClass=syndesktop-viewer
