[Desktop Entry]
Type=Application
Name=System Settings
Name[ru]=Параметры системы
GenericName=Desktop settings
GenericName[ru]=Настройка рабочего стола
Comment=Configure the syndesktop desktop
Comment[ru]=Внешний вид, панели, окна, клавиатура, мониторы syndesktop
Exec=syndesktop-settings %u
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=settings;preferences;configuration;panel;wallpaper;keyboard;shortcuts;display;
Keywords[ru]=настройки;параметры;панель;обои;клавиатура;сочетания;монитор;
StartupNotify=true
