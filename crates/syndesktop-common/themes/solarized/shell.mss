/* Solarized: цветовые акценты по смыслу — циан, маджента, оранжевый. */

.ws-active .ws-dot { background-color: var(--cyan); }
.task-urgent { border-color: var(--orange); }
.clock-date { color: var(--cyan); }
.applet-launcher .icon { icon-color: var(--orange); }
.launcher-icon-glyph, .grid-icon-glyph, .popup-big-icon, .osd-icon { icon-color: var(--cyan); }
.badge { background-color: var(--magenta); }
.badge-text { color: #fdf6e3; }
.notif-critical { border-color: var(--danger); border-width: 2px; }
