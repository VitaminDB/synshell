/* Everforest: мягкий мох вместо ярких подсветок. */

.ws-active { background-color: var(--moss-soft); }
.ws-active .ws-label { color: var(--accent); }
.ws-active .ws-dot { background-color: var(--accent); }

.task-active { background-color: var(--moss-soft); border-color: var(--moss-soft); }

.clock-time { color: var(--fg); }
.clock-date { color: var(--aqua); }
.applet-launcher .icon { icon-color: var(--accent); }

.popup-card, .notif, .osd, .switcher { box-shadow: 0 12px 34px var(--shadow); }
.popup-title, .notif-summary { color: var(--accent); }

.launcher-row-selected, .cat-item-active, .grid-cell-selected { background-color: var(--moss-soft); }
.launcher-icon-glyph, .grid-icon-glyph, .popup-big-icon, .osd-icon { icon-color: var(--aqua); }
.badge { background-color: var(--orange); }
