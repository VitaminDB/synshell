/* Синтвейв: неоновый заголовок и светящиеся кнопки. */
.brand-logo { background: linear-gradient(135deg, var(--neon-pink), #7b2cbf); glow: 0 0 12px var(--pink-glow); }
.brand-title { letter-spacing: 1px; }
.page-title { color: var(--neon-cyan); text-shadow: 0 0 10px var(--neon-cyan); letter-spacing: 1px; }
.group-title { color: var(--neon-pink); text-transform: uppercase; letter-spacing: 2px; font-size: 12px; }
.group-card { border-color: var(--pink-soft); box-shadow: 0 0 14px var(--pink-soft); }
.nav-item.active { border: 1px solid var(--neon-pink); }
.nav-item.active .nav-icon { color: var(--neon-cyan); }
Button.primary { glow: 0 0 12px var(--pink-glow); }
