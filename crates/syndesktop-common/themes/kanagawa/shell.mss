/* Kanagawa: тушь и киноварь — сдержанно, с красной печатью. */

.panel { border-color: var(--border); }

.ws-active { background-color: var(--wave); }
.ws-active .ws-label { color: var(--fg); }
.ws-active .ws-dot { background-color: var(--danger); }

.task-active { background-color: var(--wave); border-color: var(--wave); }

.clock-time { color: var(--paper); letter-spacing: 1px; }
.applet-launcher .icon { icon-color: var(--danger); }

.popup-card, .notif, .osd, .switcher { box-shadow: 0 12px 32px var(--shadow); }
.popup-title, .notif-summary { color: var(--paper); }

.launcher-row-selected, .cat-item-active, .grid-cell-selected { background-color: var(--wave); }
.launcher-icon-glyph, .grid-icon-glyph, .popup-big-icon, .osd-icon { icon-color: var(--sakura); }
.badge { background-color: var(--danger); }
.lock-avatar { background-color: var(--danger); }
