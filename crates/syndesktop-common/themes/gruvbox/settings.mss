/* Gruvbox: плотные рамки и жёлтые заголовки. */
.group-card { border: 2px solid var(--border); border-radius: 4px; box-shadow: 4px 4px 0 var(--shadow); }
.page-title { color: var(--yellow); font-weight: bold; }
.group-title { color: var(--accent); }
.nav-item { border-radius: 3px; }
Button { border-radius: 3px; }
