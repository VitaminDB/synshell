# Экран входа synshell. Установка: install -Dm644 data/synlogin.service
# /etc/systemd/system/ && systemctl enable synlogin (вместо display-manager).
# Аргументы композитора — после `--` (телефон: --cpu).
[Unit]
Description=synlogin — экран входа synshell
After=systemd-user-sessions.service dbus.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/synlogin daemon
Restart=always
RestartSec=2

[Install]
Alias=display-manager.service
