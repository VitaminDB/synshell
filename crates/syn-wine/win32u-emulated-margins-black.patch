 }
 
+/* syn-wine: поля эмулированного режима — чёрные. Окно во весь экран при режиме другого соотношения сторон
+ * (800x600 на 16:10): видимая часть строго шире окна, поля вне окна приложение не рисует, и там оставалось что
+ * попало — белая полоса слева у Heroes 3 (SM-T295): игра залила окно белым, пока оно стояло в (0,0), потом окно
+ * сдвинули на середину, а поверхность осталась прежней. Масштабирующий монитор показал бы там чёрное.
+ * inner — прямоугольник окна в координатах поверхности; всё вне него заливается чёрным. */
+void window_surface_fill_margins( struct window_surface *surface, const RECT *inner )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    RECT bounds, margins[4];
+    int i, y, row, width, height, stride, bpp;
+    char *bits;
+
+    if (!surface || surface == &dummy_surface) return;
+    window_surface_lock( surface );
+    if (!(bits = window_surface_get_color( surface, info ))) goto done;
+    width = info->bmiHeader.biWidth;
+    height = abs( info->bmiHeader.biHeight );
+    bpp = info->bmiHeader.biBitCount;
+    if (!width || !height || bpp < 8) goto done;
+    stride = info->bmiHeader.biSizeImage / height;
+    SetRect( &bounds, 0, 0, min( width, surface->rect.right - surface->rect.left ),
+             min( height, surface->rect.bottom - surface->rect.top ) );
+    SetRect( &margins[0], 0, 0, bounds.right, max( 0, inner->top ) );                      /* сверху */
+    SetRect( &margins[1], 0, min( bounds.bottom, inner->bottom ), bounds.right, bounds.bottom ); /* снизу */
+    SetRect( &margins[2], 0, max( 0, inner->top ), max( 0, inner->left ), min( bounds.bottom, inner->bottom ) );
+    SetRect( &margins[3], min( bounds.right, inner->right ), max( 0, inner->top ), bounds.right,
+             min( bounds.bottom, inner->bottom ) );
+    for (i = 0; i < ARRAY_SIZE(margins); i++)
+    {
+        if (!intersect_rect( &margins[i], &margins[i], &bounds )) continue;
+        for (y = margins[i].top; y < margins[i].bottom; y++)
+        {
+            row = info->bmiHeader.biHeight > 0 ? height - 1 - y : y;
+            memset( bits + row * stride + margins[i].left * bpp / 8, 0,
+                    (margins[i].right - margins[i].left) * bpp / 8 );
+        }
+        add_bounds_rect( &surface->bounds, &margins[i] );
+    }
+done:
+    window_surface_unlock( surface );
+}
+
 void window_surface_flush( struct window_surface *surface )
 {
     char color_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
