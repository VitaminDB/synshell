+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+/***********************************************************************
+ *           touchscreen as a mouse (syn-wine)
+ *
+ * The compositor passes real touches to windows marked _SYN_WINE_TOUCH; the X server emulates the pointer for
+ * them and raw touch events (XI_RawTouchBegin/End on the root window, delivered whatever grabs are active and
+ * ahead of the emulated pointer events) say a finger is down: while it is, the pointer is that finger, never a
+ * mouse -- no guessing from the events themselves. Games want a mouse: the first finger moves the cursor and
+ * holds the left button, other fingers are ignored. A real mouse moving (raw motion without XIPointerEmulated)
+ * ends the finger. Raw input (WM_INPUT, DirectInput) gets the motion too, in the
+ * game's client coordinates (emulated display modes included): a game drawing its own cursor from DirectInput
+ * deltas follows the finger. Where that cursor is, is unknown (Fable resets it between screens), so a touch
+ * sends it to the bottom-right corner first and on to the finger in a later frame -- a game sums the deltas of
+ * one frame -- and presses the button in a frame after that. Not the top-left corner: Fable lets its cursor go a
+ * menu row above the top edge while the drawn one stops there, and every touch then hit the item above. A frame is a message pump of the program's thread
+ * (x11drv_touch_poll), or the program putting the cursor onto the corner (SetCursorPos onto its own cursor: it
+ * has consumed the corner delta). The window's thread pumps X events only when some come, so the steps go by
+ * a driver system timer of the window (WINE_SYSTEM_TIMER_DRIVER): its WM_SYSTIMER comes at a message pump of
+ * the program. Raw frames are sent at once (MOUSEEVENTF_MOVE_NOCOALESCE): win32u would keep them until the
+ * thread pumps events, and SetCursorPos may come from a thread that never does.
+ */
+#define TOUCH_STEP_MS  16   /* between the steps of a touch */
+#define TOUCH_START_MS 500  /* a finger with no position by then is dropped */
+
+static struct
+{
+    pthread_mutex_t mutex;
+    BOOL  active;          /* a finger acts as the mouse: from XI_RawTouchBegin until it is released */
+    BOOL  started;         /* its first position came (emulated pointer motion) */
+    int   id;              /* its XI2 touch id */
+    HWND  hwnd;            /* window it touched */
+    POINT pt;              /* where it is: virtual screen coordinates, for mouse messages */
+    BOOL  abs_pending;     /* raw: game cursor sent to the corner, not yet on to abs_to */
+    POINT abs_to;          /* raw: where the finger puts the game cursor (game client coordinates) */
+    SIZE  client;          /* game client area size: the corner is its bottom-right pixel */
+    BOOL  press_pending;   /* the left button is not pressed yet */
+    BOOL  release_pending; /* the finger is up: release once pressed */
+    DWORD step_tick;       /* when the last step was made (the touch began, before any) */
+    HWND  timer;           /* window with the driver timer making the steps */
+} touch = { PTHREAD_MUTEX_INITIALIZER };
+
+/* steps of the finger are left: mutex held */
+static BOOL touch_pending_locked(void)
+{
+    return touch.active && touch.started && (touch.abs_pending || touch.press_pending || touch.release_pending);
+}
+
+/* the window to start the step timer on, if it is not running; mutex held */
+static HWND touch_kick_locked(void)
+{
+    if (touch.timer || !touch_pending_locked() || !touch.hwnd) return 0;
+    return touch.timer = touch.hwnd;
+}
+
+static void touch_kick( HWND hwnd )
+{
+    if (hwnd) NtUserSetSystemTimer( hwnd, WINE_SYSTEM_TIMER_DRIVER, TOUCH_STEP_MS );
+}
+
+static void touch_cancel(void);
+static BOOL touch_pointer_motion( HWND hwnd, POINT pt, UINT time );
+
+/* finger position (virtual screen) in the client coordinates of the foreground window, which the game sees in
+ * its own (possibly emulated) display mode */
+static BOOL touch_client_pos( POINT pt, POINT *pos, SIZE *size )
+{
+    HWND foreground = NtUserGetForegroundWindow();
+    struct x11drv_win_data *win;
+    RECT client, phys;
+    UINT dpi;
+
+    /* a window being recreated (display mode change) has no DPI yet, win32u asserts on it */
+    if (!foreground || !(dpi = NtUserGetDpiForWindow( foreground ))) return FALSE;
+    if (!NtUserGetClientRect( foreground, &client, dpi )) return FALSE;
+    if (!(win = get_win_data( foreground ))) return FALSE;
+    phys = win->rects.client;
+    release_win_data( win );
+    if (phys.right <= phys.left || phys.bottom <= phys.top || client.right <= 0 || client.bottom <= 0) return FALSE;
+    pos->x = (LONGLONG)(pt.x - phys.left) * client.right / (phys.right - phys.left);
+    pos->y = (LONGLONG)(pt.y - phys.top) * client.bottom / (phys.bottom - phys.top);
+    pos->x = max( 0, min( pos->x, client.right - 1 ) );
+    pos->y = max( 0, min( pos->y, client.bottom - 1 ) );
+    size->cx = client.right;
+    size->cy = client.bottom;
+    return TRUE;
+}
+
+/* the finger's button to raw input (DirectInput): as X11DRV_RawButtonEvent does for a mouse button -- the
+ * emulated raw buttons of a finger are dropped */
+static void touch_send_raw_button( DWORD flags )
+{
+    struct raw_mouse raw = { .count = 1 };
+    send_mouse_input( NULL, (POINT){ 0, 0 }, flags, 0, NtGetTickCount(), &raw );
+}
+
+static void touch_send_raw( LONG dx, LONG dy )
+{
+    struct raw_mouse raw = { .count = 1 };
+
+    if (!dx && !dy) return;
+    raw.data[0].x = dx;
+    raw.data[0].y = dy;
+    send_mouse_input( NULL, (POINT){ 0, 0 }, MOUSEEVENTF_MOVE_NOCOALESCE, 0, NtGetTickCount(), &raw );
+}
+
+/* the game cursor is in the corner (or should be by now): on to the finger; mutex held, released */
+static void touch_leave_corner_locked(void)
+{
+    POINT to = touch.abs_to;
+    SIZE size = touch.client;
+
+    touch.abs_pending = FALSE;
+    touch.step_tick = NtGetTickCount();
+    pthread_mutex_unlock( &touch.mutex );
+    TRACE( "client pos %s from the corner of %dx%d\n", wine_dbgstr_point( &to ), (int)size.cx, (int)size.cy );
+    touch_send_raw( to.x - (size.cx - 1), to.y - (size.cy - 1) );
+}
+
+/* the program puts the cursor onto the bottom-right corner of its client area: its own cursor is there, so it has
+ * consumed the corner delta. Its SetCursorPos alone proves nothing: a game puts the cursor on its own every frame */
+static void touch_cursor_set( INT x, INT y )
+{
+    HWND foreground;
+    struct x11drv_win_data *win;
+    RECT client;
+
+    if (!touch.abs_pending) return; /* unlocked peek: the usual case, no touch */
+    if (!(foreground = NtUserGetForegroundWindow()) || !(win = get_win_data( foreground ))) return;
+    client = win->rects.client;
+    release_win_data( win );
+    if (x < client.right - 3 || x > client.right + 1 || y < client.bottom - 3 || y > client.bottom + 1) return;
+
+    pthread_mutex_lock( &touch.mutex );
+    if (touch.abs_pending) touch_leave_corner_locked();
+    else pthread_mutex_unlock( &touch.mutex );
+}
+
+/* one step of a touch: corner -> finger -> press -> release, at least min_ms after the previous one */
+static void touch_step( DWORD min_ms )
+{
+    HWND hwnd;
+    POINT pt;
+    DWORD now;
+
+    if (!touch.active) return; /* unlocked peek */
+    pthread_mutex_lock( &touch.mutex );
+    now = NtGetTickCount();
+    if (touch.active && !touch.started && now - touch.step_tick >= TOUCH_START_MS) touch.active = FALSE;
+    if (!touch.active || !touch.started || now - touch.step_tick < min_ms)
+    {
+        pthread_mutex_unlock( &touch.mutex );
+        return;
+    }
+    if (touch.abs_pending)
+    {
+        touch_leave_corner_locked();
+        return;
+    }
+    hwnd = touch.hwnd;
+    pt = touch.pt;
+    touch.step_tick = now;
+    if (touch.press_pending)
+    {
+        touch.press_pending = FALSE;
+        pthread_mutex_unlock( &touch.mutex );
+        TRACE( "press at %s\n", wine_dbgstr_point( &pt ) );
+        send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_LEFTDOWN, 0, now, NULL );
+        touch_send_raw_button( MOUSEEVENTF_LEFTDOWN );
+        return;
+    }
+    if (touch.release_pending)
+    {
+        touch.release_pending = FALSE;
+        touch.active = FALSE;
+        pthread_mutex_unlock( &touch.mutex );
+        TRACE( "release at %s\n", wine_dbgstr_point( &pt ) );
+        send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_LEFTUP, 0, now, NULL );
+        touch_send_raw_button( MOUSEEVENTF_LEFTUP );
+        return;
+    }
+    pthread_mutex_unlock( &touch.mutex );
+}
+
+/* at a pump of a thread: the program has had a frame */
+void x11drv_touch_poll(void)
+{
+    touch_step( TOUCH_STEP_MS );
+}
+
+/* the step timer of the window (WM_SYSTIMER WINE_SYSTEM_TIMER_DRIVER): the next step; off when none is left */
+void x11drv_touch_timer( HWND hwnd )
+{
+    BOOL done;
+
+    touch_step( TOUCH_STEP_MS );
+    pthread_mutex_lock( &touch.mutex );
+    done = !touch_pending_locked() || touch.timer != hwnd;
+    if (done && touch.timer == hwnd) touch.timer = 0;
+    pthread_mutex_unlock( &touch.mutex );
+    if (done) NtUserKillSystemTimer( hwnd, WINE_SYSTEM_TIMER_DRIVER );
+}
+#else
+void x11drv_touch_poll(void) {}
+#endif
