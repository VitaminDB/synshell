+#ifdef HAVE_X11_EXTENSIONS_XINPUT2_H
+/***********************************************************************
+ *           send_absolute_raw
+ *
+ * Raw input (WM_INPUT, DirectInput) carries only XI2 raw motion, and an absolute pointer without it (a
+ * touchscreen driven as a mouse by the compositor) moved the cursor but gave raw input zero deltas: a game
+ * drawing its own cursor from DirectInput deltas never moved. Feed raw input the touch in the game's client
+ * coordinates (emulated display modes included). Where the game cursor is, is unknown (Fable resets it between
+ * screens), so a touch first sends it to the top-left corner and then on to the touch — in a later frame, the
+ * game sums the deltas of one frame: when the game puts the cursor on the corner (SetCursorPos onto its own
+ * cursor: it has consumed the corner delta), or at the press (the compositor sends it a few frames after the
+ * touch). Dragging moves it along. The raw frames are sent at once (MOUSEEVENTF_MOVE_NOCOALESCE): win32u would
+ * otherwise keep them until the thread pumps events, and SetCursorPos may come from a thread that never does.
+ */
+static void send_absolute_raw( POINT pos, BOOL down )
+{
+    struct raw_mouse raw = { 0 };
+    HWND foreground = NtUserGetForegroundWindow();
+    struct x11drv_win_data *win;
+    RECT client, phys;
+    BOOL corner = FALSE;
+    UINT dpi;
+
+    /* the event position is physical; the game sees its client area in its own (possibly emulated) mode;
+     * a window being recreated (display mode change) has no DPI yet, win32u asserts on it */
+    if (!foreground || !(dpi = NtUserGetDpiForWindow( foreground ))) return;
+    if (!NtUserGetClientRect( foreground, &client, dpi )) return;
+    if (!(win = get_win_data( foreground ))) return;
+    phys = win->rects.client;
+    release_win_data( win );
+    if (phys.right <= phys.left || phys.bottom <= phys.top || client.right <= 0 || client.bottom <= 0) return;
+    pos.x = (LONGLONG)(pos.x - phys.left) * client.right / (phys.right - phys.left);
+    pos.y = (LONGLONG)(pos.y - phys.top) * client.bottom / (phys.bottom - phys.top);
+    pos.x = max( 0, min( pos.x, client.right - 1 ) );
+    pos.y = max( 0, min( pos.y, client.bottom - 1 ) );
+
+    pthread_mutex_lock( &touch.mutex );
+    if (down)
+    {
+        /* to the corner once per touch: more motion before the press only moves the target */
+        if (!touch.abs_pending)
+        {
+            raw.data[0].x = raw.data[0].y = -0x10000;
+            corner = TRUE;
+        }
+        touch.abs_pending = TRUE;
+    }
+    else if (touch.abs_pending) /* still on the way from the corner */
+    {
+        touch.abs_to = pos;
+        pthread_mutex_unlock( &touch.mutex );
+        return;
+    }
+    else
+    {
+        raw.data[0].x = pos.x - touch.abs_to.x;
+        raw.data[0].y = pos.y - touch.abs_to.y;
+    }
+    touch.abs_to = pos;
+    pthread_mutex_unlock( &touch.mutex );
+    raw.count = 1;
+    TRACE( "client pos %s%s in %s (physical %s)\n", wine_dbgstr_point( &pos ), corner ? " via the corner" : "",
+           wine_dbgstr_rect( &client ), wine_dbgstr_rect( &phys ) );
+    if (raw.data[0].x || raw.data[0].y)
+        send_mouse_input( NULL, (POINT){ 0, 0 }, MOUSEEVENTF_MOVE_NOCOALESCE, 0, NtGetTickCount(), &raw );
+}
+
+/* the game cursor is in the corner (or should be by now): move it on to the touch */
+static void send_absolute_raw_pending(void)
+{
+    struct raw_mouse raw = { .count = 1 };
+
+    pthread_mutex_lock( &touch.mutex );
+    if (!touch.abs_pending)
+    {
+        pthread_mutex_unlock( &touch.mutex );
+        return;
+    }
+    touch.abs_pending = FALSE;
+    raw.data[0] = touch.abs_to;
+    pthread_mutex_unlock( &touch.mutex );
+    TRACE( "client pos %s from the corner\n", wine_dbgstr_point( &raw.data[0] ) );
+    send_mouse_input( NULL, (POINT){ 0, 0 }, MOUSEEVENTF_MOVE_NOCOALESCE, 0, NtGetTickCount(), &raw );
+}
+#endif
