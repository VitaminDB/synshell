+/* raw touch event (root window): a finger is down or up */
+static BOOL X11DRV_RawTouchEvent( XGenericEventCookie *xev )
+{
+    XIRawEvent *event = xev->data;
+    HWND foreground = NtUserGetForegroundWindow(), kick;
+
+    /* every thread with windows gets raw touches on its own connection; only on the connection that gets the
+     * window's pointer events do they come ahead of them: the thread of the foreground window drives the finger */
+    if (!foreground || NtUserGetWindowThread( foreground, NULL ) != GetCurrentThreadId()) return FALSE;
+
+    pthread_mutex_lock( &touch.mutex );
+    switch (event->evtype)
+    {
+    case XI_RawTouchBegin:
+        if (touch.active) break; /* another finger */
+        touch.active = TRUE;
+        touch.started = FALSE;
+        touch.id = event->detail;
+        touch.press_pending = TRUE;
+        touch.release_pending = FALSE;
+        touch.abs_pending = FALSE;
+        touch.step_tick = NtGetTickCount();
+        TRACE( "finger %u down\n", event->detail );
+        break;
+    case XI_RawTouchEnd:
+        if (!touch.active || touch.id != event->detail) break;
+        TRACE( "finger %u up\n", event->detail );
+        if (touch.started) touch.release_pending = TRUE; /* x11drv_touch_poll releases it */
+        else touch.active = FALSE; /* never got a position: nothing was sent */
+        break;
+    }
+    kick = touch_kick_locked();
+    pthread_mutex_unlock( &touch.mutex );
+    touch_kick( kick );
+    return TRUE;
+}
+
+/* a real mouse moved: the pointer is no finger any more */
+static void touch_cancel(void)
+{
+    HWND kick;
+
+    if (!touch.active) return; /* unlocked peek */
+    pthread_mutex_lock( &touch.mutex );
+    if (touch.active && touch.press_pending) touch.active = FALSE; /* nothing pressed yet: just forget it */
+    else if (touch.active) touch.release_pending = TRUE;
+    kick = touch_kick_locked();
+    pthread_mutex_unlock( &touch.mutex );
+    touch_kick( kick );
+}
+
+/* pointer motion while a finger is down: it is the finger's (emulated); TRUE -- consumed */
+static BOOL touch_pointer_motion( HWND hwnd, POINT pt, UINT time )
+{
+    POINT pos, prev;
+    SIZE size;
+    BOOL have_pos;
+    HWND kick;
+
+    if (!touch.active) return FALSE; /* unlocked peek: the usual case */
+    have_pos = touch_client_pos( pt, &pos, &size );
+    if (!hwnd) hwnd = NtUserGetForegroundWindow(); /* the cursor clipping window has none */
+
+    pthread_mutex_lock( &touch.mutex );
+    if (!touch.active)
+    {
+        pthread_mutex_unlock( &touch.mutex );
+        return FALSE;
+    }
+    if (!touch.started)
+    {
+        touch.started = TRUE;
+        touch.hwnd = hwnd;
+        touch.pt = pt;
+        touch.abs_pending = have_pos;
+        if (have_pos)
+        {
+            touch.abs_to = pos;
+            touch.client = size;
+        }
+        touch.step_tick = NtGetTickCount();
+        kick = touch_kick_locked();
+        pthread_mutex_unlock( &touch.mutex );
+        touch_kick( kick );
+        TRACE( "finger %u at %s, client %s\n", touch.id, wine_dbgstr_point( &pt ), wine_dbgstr_point( &pos ) );
+        send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+        if (have_pos) touch_send_raw( 0x10000, 0x10000 ); /* game cursor to the bottom-right corner */
+        return TRUE;
+    }
+    if (touch.release_pending)
+    {
+        pthread_mutex_unlock( &touch.mutex );
+        return TRUE;
+    }
+    touch.pt = pt;
+    touch.hwnd = hwnd;
+    prev = touch.abs_to;
+    if (have_pos) touch.abs_to = pos;
+    if (touch.abs_pending || !have_pos)
+    {
+        pthread_mutex_unlock( &touch.mutex ); /* still on the way from the corner: only the target moves */
+        send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+        return TRUE;
+    }
+    pthread_mutex_unlock( &touch.mutex );
+    send_mouse_input( hwnd, pt, MOUSEEVENTF_ABSOLUTE, 0, time, NULL );
+    touch_send_raw( pos.x - prev.x, pos.y - prev.y );
+    return TRUE;
+}
