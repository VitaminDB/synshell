+/* A touchscreen driven by the compositor as an absolute pointer, fed to raw input (DirectInput): see
+ * send_absolute_raw. Shared by the thread pumping X events and the one calling SetCursorPos (usually the same). */
+static struct
+{
+    pthread_mutex_t mutex;
+    Time  raw_time;      /* X time of the last XI_RawMotion with relative motion (a mouse) */
+    BOOL  abs_pending;   /* touch down: game cursor sent to the corner, abs_to not yet */
+    POINT abs_to;        /* where the touch put the game cursor (game client coordinates) */
+    struct { POINT pos; DWORD tick; } warp[8]; /* recent cursor warps: root coordinates, time */
+    UINT  warp_next;
+} touch = { PTHREAD_MUTEX_INITIALIZER };
+
+/* the echo of a warp comes within a few frames; an older warp target is a place a finger may touch */
+#define WARP_ECHO_MS 300
+
+/* motion to where the program has recently put the cursor (its echo may come after later warps), not a touch */
+static BOOL is_warp_target( POINT pt )
+{
+    DWORD now = NtGetTickCount();
+    BOOL ret = FALSE;
+    UINT i;
+
+    pthread_mutex_lock( &touch.mutex );
+    for (i = 0; i < ARRAY_SIZE(touch.warp) && !ret; i++)
+    {
+        POINT warp = root_to_virtual_screen( touch.warp[i].pos.x, touch.warp[i].pos.y );
+        if (now - touch.warp[i].tick > WARP_ECHO_MS) continue;
+        ret = pt.x == warp.x && pt.y == warp.y;
+    }
+    pthread_mutex_unlock( &touch.mutex );
+    return ret;
+}
+
+/* the program puts the cursor on the top-left corner of its client area: its own cursor is there, so it has
+ * consumed the corner delta of a touch. Its SetCursorPos alone proves nothing: a game puts the cursor on its own
+ * every frame, before or after reading the deltas (raw input is parsed by another thread). */
+static BOOL is_client_corner( INT x, INT y )
+{
+    HWND foreground = NtUserGetForegroundWindow();
+    struct x11drv_win_data *win;
+    RECT client;
+
+    if (!foreground || !(win = get_win_data( foreground ))) return FALSE;
+    client = win->rects.client;
+    release_win_data( win );
+    return x >= client.left - 2 && x <= client.left + 2 && y >= client.top - 2 && y <= client.top + 2;
+}
+#endif
