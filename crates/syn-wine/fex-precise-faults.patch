+void OpDispatchBuilder::DivideErrorCheck(OpcodeArgs, Ref Lhs, Ref Rhs, CondClass Cond, IR::OpSize CompareSize) {
+  // x86 raises #DE on a zero divisor and on a quotient that does not fit the destination, while ARM udiv/sdiv
+  // return 0 or truncate. Software relies on the exception (e.g. SecuROM uses it for control flow), so branch to
+  // a fault with RIP at the faulting instruction when Lhs <Cond> Rhs.
+  // The check splits the block and values do not live across blocks: callers load their operands again after it.
+  CalculateDeferredFlags();
+
+  auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  auto EndBlock = CreateNewCodeBlockAfter(FaultBlock);
+  // CondJump compares only against zero (cbz/cbnz/tbz): evaluate the condition first.
+  Ref Fault = _Select(OpSize::i32Bit, CompareSize, Cond, Lhs, Rhs, Constant(1), Constant(0));
+  CondJump(Fault, Constant(0), FaultBlock, EndBlock, CondClass::NEQ, OpSize::i32Bit);
+
+  SetCurrentCodeBlock(FaultBlock);
+  StartNewBlock();
+  {
+    auto NewRIP = GetRelocatedPC(Op, -Op->InstSize);
+    _StoreContextGPR(GetGPROpSize(), NewRIP, offsetof(FEXCore::Core::CPUState, rip));
+    Break(FEXCore::IR::BreakDefinition {
+      .ErrorRegister = 0,
+      .Signal = Core::FAULT_SIGFPE,
+      .TrapNumber = X86State::X86_TRAPNO_DE,
+      .si_code = 1, // FPE_INTDIV
+    });
+  }
+
+  SetCurrentCodeBlock(EndBlock);
+  StartNewBlock();
+}
