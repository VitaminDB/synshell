+static bool OperandUsesGPR(const X86Tables::DecodedOperand& Operand, uint8_t GPR) {
+  if (Operand.IsGPRIndirect() || Operand.IsGPRIndirectRelocation()) {
+    return Operand.Data.GPRIndirect.GPR == GPR;
+  }
+  if (Operand.IsSIB() || Operand.IsSIBRelocation()) {
+    return Operand.Data.SIB.Base == GPR || Operand.Data.SIB.Index == GPR;
+  }
+  return false;
+}
+
 void OpDispatchBuilder::POPOp(OpcodeArgs) {
+  // POP to memory must not update RSP before its store: the store can fault (an RWX page write-protected for
+  // self-modifying code tracking) and the instruction is then restarted, popping twice. x86 faults are precise.
+  // With RSP in the address it is computed after the increment, keep the plain path for that rare case.
+  if (!Op->Dest.IsGPR() && !OperandUsesGPR(Op->Dest, X86State::REG_RSP)) {
+    const auto Size = OpSizeFromSrc(Op);
+    Ref SP = LoadGPRRegister(X86State::REG_RSP);
+    Ref Value = _LoadMemGPR(Size, SP, Size);
+    StoreResultGPR(Op, Value);
+    StoreGPRRegister(X86State::REG_RSP, Add(GetGPROpSize(), SP, IR::OpSizeToSize(Size)));
+    return;
+  }
+
   Ref Value = Pop(OpSizeFromSrc(Op));
   StoreResultGPR(Op, Value);
 }
