+/* syn-wine: a GStreamer plugin is missing -- syn-wine-helper (from PATH) offers the distribution package
+ * that has it. what: "caps:<caps>" (decoder/demuxer for these caps) or "plugins:<set>" (base, good, ugly, bad,
+ * libav). Each once per process; SYN_WINE_HELPER=0 -- not called. */
+void report_missing_plugin(const char *what)
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static char *seen[32];
+    static unsigned int seen_count;
+    const char *env = getenv("SYN_WINE_HELPER");
+    char exe[64] = "", *argv[7];
+    unsigned int i;
+    FILE *f;
+
+    if (!what || !*what || (env && env[0] == '0')) return;
+    pthread_mutex_lock(&lock);
+    for (i = 0; i < seen_count; i++) if (!strcmp(seen[i], what)) break;
+    if (i < seen_count || seen_count == ARRAY_SIZE(seen) || !(seen[seen_count] = strdup(what)))
+    {
+        pthread_mutex_unlock(&lock);
+        return;
+    }
+    seen_count++;
+    pthread_mutex_unlock(&lock);
+
+    if ((f = fopen("/proc/self/comm", "r")))
+    {
+        if (fgets(exe, sizeof(exe), f)) exe[strcspn(exe, "\n")] = 0;
+        fclose(f);
+    }
+    argv[0] = (char *)"syn-wine-helper";
+    argv[1] = (char *)"gst-missing";
+    argv[2] = (char *)"--exe";
+    argv[3] = exe;
+    argv[4] = (char *)"--";
+    argv[5] = (char *)what;
+    argv[6] = NULL;
+    __wine_unix_spawnvp(argv, FALSE);
+}
+
+void report_missing_caps(GstCaps *caps)
+{
+    gchar *str, *what;
+
+    if (!caps || gst_caps_is_any(caps) || gst_caps_is_empty(caps)) return;
+    str = gst_caps_to_string(caps);
+    what = g_strconcat("caps:", str, NULL);
+    report_missing_plugin(what);
+    g_free(what);
+    g_free(str);
+}
+
 GstElement *create_element(const char *name, const char *plugin_set)
 {
     GstElement *element;
 
     if (!(element = gst_element_factory_make(name, NULL)))
+    {
         fprintf(stderr, "winegstreamer: failed to create %s, are %u-bit GStreamer \"%s\" plugins installed?\n",
                 name, 8 * (unsigned int)sizeof(void *), plugin_set);
+        if (plugin_set)
+        {
+            gchar *what = g_strconcat("plugins:", plugin_set, NULL);
+            report_missing_plugin(what);
+            g_free(what);
+        }
+    }
     return element;
 }
 
