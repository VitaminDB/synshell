+/* каталог DLL syn-wine-helper (общий для всех префиксов): $SYN_WINE_DLLS или
+ * $XDG_DATA_HOME/syn-wine/dlls (~/.local/share/syn-wine/dlls) */
+static const char *syn_wine_dll_dir(void)
+{
+    static char *dir;
+    const char *p;
+
+    if (dir) return dir;
+    if ((p = getenv( "SYN_WINE_DLLS" )) && *p) return dir = strdup( p );
+    if ((p = getenv( "XDG_DATA_HOME" )) && *p == '/') asprintf( &dir, "%s/syn-wine/dlls", p );
+    else if (home_dir) asprintf( &dir, "%s/.local/share/syn-wine/dlls", home_dir );
+    return dir;
+}
