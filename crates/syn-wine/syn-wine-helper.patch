 /***********************************************************************
+ *	find_syn_wine_dll
+ *
+ * syn-wine-helper: DLL, которых нет в Wine (MFC, рантаймы VB, OpenAL…), лежат в одном каталоге
+ * пользователя для всех префиксов ($WINESYNDLLDIR\<arch>-windows, его задаёт unix-часть ntdll);
+ * ищутся последними, модуль виден программе как system32\<имя>.
+ */
+static NTSTATUS find_syn_wine_dll( const WCHAR *name, UNICODE_STRING *new_name,
+                                   WINE_MODREF **pwm, HANDLE *mapping,
+                                   SECTION_IMAGE_INFORMATION *image_info, struct file_id *id )
+{
+#ifdef _WIN64
+    static const WCHAR arch_dir[] = L"\\x86_64-windows\\";
+#else
+    static const WCHAR arch_dir[] = L"\\i386-windows\\";
+#endif
+    NTSTATUS status;
+
+    if (contains_path( name )) return STATUS_DLL_NOT_FOUND;
+    if (get_env_var( L"WINESYNDLLDIR", wcslen(arch_dir) + wcslen(name), new_name ))
+        return STATUS_DLL_NOT_FOUND;
+    RtlAppendUnicodeToString( new_name, arch_dir );
+    RtlAppendUnicodeToString( new_name, name );
+    status = open_dll_file( new_name, pwm, mapping, image_info, id );
+    RtlFreeUnicodeString( new_name );
+    if (status) return STATUS_DLL_NOT_FOUND;
+    TRACE( "%s from syn-wine\n", debugstr_w(name) );
+    build_sysdir_nt_name( name, new_name );
+    return status;
+}
+
