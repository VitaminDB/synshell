--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1137,6 +1137,84 @@
 }
 
 
+/* имена DLL, не найденных при разрешении импортов, — для syn-wine-helper */
+static char missing_dlls[1024];
+static unsigned int missing_dlls_len, missing_dlls_reported;
+
+static void note_missing_dll( const char *name )
+{
+    unsigned int len = strlen( name ) + 1;
+    const char *p;
+
+    for (p = missing_dlls; p < missing_dlls + missing_dlls_len; p += strlen( p ) + 1)
+        if (!_stricmp( p, name )) return;
+    if (missing_dlls_len + len > sizeof(missing_dlls)) return;
+    memcpy( missing_dlls + missing_dlls_len, name, len );
+    missing_dlls_len += len;
+}
+
+static char *syn_utf8( const UNICODE_STRING *str )
+{
+    DWORD len = 0;
+    char *ret;
+
+    RtlUnicodeToUTF8N( NULL, 0, &len, str->Buffer, str->Length );
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, len + 1 ))) return NULL;
+    RtlUnicodeToUTF8N( ret, len, &len, str->Buffer, str->Length );
+    ret[len] = 0;
+    return ret;
+}
+
+/***********************************************************************
+ *		run_missing_dll_helper
+ *
+ * Нет DLL из таблицы импорта: программа не запустилась (running = FALSE) или не загрузилась её DLL
+ * (LoadLibrary, running = TRUE — сама DLL есть, не хватает её зависимости). syn-wine-helper (из PATH)
+ * предлагает поставить недостающее; без него — как раньше. О каждом имени — один раз за процесс.
+ * SYN_WINE_HELPER=0 — не звать.
+ */
+static void run_missing_dll_helper( BOOL running )
+{
+    RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( NtCurrentTeb()->Peb->ImageBaseAddress );
+    char machine[8], *argv[64], *exe, *cwd, *cmdline, *p;
+    WCHAR off[2];
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"SYN_WINE_HELPER" ), val = { 0, sizeof(off), off };
+    unsigned int i, argc = 0;
+
+    if (missing_dlls_reported >= missing_dlls_len) return;
+    if (!RtlQueryEnvironmentVariable_U( NULL, &name, &val ) && val.Length && off[0] == '0') return;
+    exe = syn_utf8( &params->ImagePathName );
+    cwd = syn_utf8( &params->CurrentDirectory.DosPath );
+    cmdline = syn_utf8( &params->CommandLine );
+    if (!exe || !cwd || !cmdline) goto done;
+    for (i = 0; i < 4; i++) machine[i] = "0123456789abcdef"[((nt ? nt->FileHeader.Machine : 0) >> (12 - 4 * i)) & 0xf];
+    machine[4] = 0;
+
+    argv[argc++] = (char *)"syn-wine-helper";
+    argv[argc++] = (char *)"missing";
+    argv[argc++] = (char *)"--machine";
+    argv[argc++] = machine;
+    argv[argc++] = (char *)"--exe";
+    argv[argc++] = exe;
+    argv[argc++] = (char *)"--cwd";
+    argv[argc++] = cwd;
+    argv[argc++] = (char *)"--cmdline";
+    argv[argc++] = cmdline;
+    if (running) argv[argc++] = (char *)"--running";
+    argv[argc++] = (char *)"--";
+    for (p = missing_dlls + missing_dlls_reported; p < missing_dlls + missing_dlls_len && argc < ARRAY_SIZE(argv) - 1; p += strlen( p ) + 1)
+        argv[argc++] = p;
+    argv[argc] = NULL;
+    missing_dlls_reported = missing_dlls_len;
+    __wine_unix_spawnvp( argv, FALSE );
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, exe );
+    RtlFreeHeap( GetProcessHeap(), 0, cwd );
+    RtlFreeHeap( GetProcessHeap(), 0, cmdline );
+}
+
