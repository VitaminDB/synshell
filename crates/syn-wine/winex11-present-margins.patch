+/* syn-wine: the same for a client window on screen: GL draws into a child X window over part of the fullscreen
+ * toplevel (emulated mode of another aspect), and the rest of the toplevel kept whatever was drawn there before --
+ * a white 800x600 rect in Heroes 3, painted while it had a window surface. A black background and a clear: the X
+ * server paints the margins, the child is not touched. */
+static void clear_onscreen_margins( HWND hwnd, struct x11drv_client_surface *surface )
+{
+    struct x11drv_win_data *data;
+    int w, h;
+
+    if (surface->client.offscreen || NtUserGetAncestor( hwnd, GA_ROOT ) != hwnd) return;
+    if (!(data = get_win_data( hwnd ))) return;
+    w = data->rects.visible.right - data->rects.visible.left;
+    h = data->rects.visible.bottom - data->rects.visible.top;
+    /* margins: the visible rect strictly wider than the window rect -- nothing of the program is drawn there */
+    if (data->whole_window && data->client_window == surface->window &&
+        !EqualRect( &data->rects.visible, &data->rects.window ) &&
+        data->rects.visible.left <= data->rects.window.left && data->rects.visible.top <= data->rects.window.top &&
+        data->rects.visible.right >= data->rects.window.right && data->rects.visible.bottom >= data->rects.window.bottom)
+    {
+        /* a window of a GL format with alpha has a 32-bit visual: black 0 there is transparent, and whatever lies
+         * under the window shows through (Heroes 3: its white 800x600 window) -- opaque black */
+        unsigned long black = data->vis.depth == 32 ? 0xff000000 : BlackPixel( gdi_display, DefaultScreen( gdi_display ) );
+
+        TRACE( "%p/%lx: margins around %d,%d %dx%d of %dx%d black, depth %d\n", hwnd, data->whole_window,
+               surface->changes.x, surface->changes.y, surface->changes.width, surface->changes.height, w, h,
+               data->vis.depth );
+        XSetWindowBackground( gdi_display, data->whole_window, black );
+        XClearWindow( gdi_display, data->whole_window );
+        XFlush( gdi_display );
+    }
+    release_win_data( data );
+}
+
 static void x11drv_client_surface_update( struct client_surface *client )
 {
     struct x11drv_client_surface *surface = impl_from_client_surface( client );
     HWND hwnd = client->hwnd;
 
+    XWindowChanges changes = surface->changes;
+    Window attached = 0;
+    struct x11drv_win_data *data;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        attached = data->client_window;
+        release_win_data( data );
+    }
     client_surface_update_geometry( hwnd, surface );
     client_surface_update_offscreen( hwnd, surface );
+    /* only when the child moved or was just attached: not at every frame */
+    if (memcmp( &changes, &surface->changes, sizeof(changes) ) || attached != surface->window)
+        clear_onscreen_margins( hwnd, surface );
+}
+
+/* An emulated display mode with another aspect presents into part of the fullscreen window: the rest showed
+ * whatever the window surface held there (white in Fable). Paint it black, as a scaling display would. */
+static void fill_present_margins( Drawable window, HWND toplevel, const RECT *dst )
+{
+    static GC gc;
+    struct x11drv_win_data *data;
+    XRectangle bands[4];
+    int count = 0, w, h;
+
+    if (!(data = get_win_data( toplevel ))) return;
+    w = data->rects.visible.right - data->rects.visible.left;
+    h = data->rects.visible.bottom - data->rects.visible.top;
+    release_win_data( data );
+    if (dst->left <= 0 && dst->top <= 0 && dst->right >= w && dst->bottom >= h) return;
+
+    if (!gc)
+    {
+        XGCValues values = { .foreground = BlackPixel( gdi_display, DefaultScreen( gdi_display ) ),
+                             .subwindow_mode = IncludeInferiors };
+        gc = XCreateGC( gdi_display, window, GCForeground | GCSubwindowMode, &values );
+    }
+    if (dst->left > 0) bands[count++] = (XRectangle){ 0, 0, dst->left, h };
+    if (dst->right < w) bands[count++] = (XRectangle){ dst->right, 0, w - dst->right, h };
+    if (dst->top > 0) bands[count++] = (XRectangle){ dst->left, 0, dst->right - dst->left, dst->top };
+    if (dst->bottom < h) bands[count++] = (XRectangle){ dst->left, dst->bottom, dst->right - dst->left, h - dst->bottom };
+    XFillRectangles( gdi_display, window, gc, bands, count );
 }
 
