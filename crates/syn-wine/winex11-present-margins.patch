 /***********************************************************************
  *           x11drv_surface_flush
  */
+/* syn-wine: margins of an emulated display mode of another aspect (800x600 on 16:10) -- the visible rect of the
+ * fullscreen window strictly wider than the window rect. The window surface of such a window is in the program's
+ * coordinates and lands at the origin of the X window, unshifted: in Heroes 3 its white 800x600 background showed in
+ * the left margin next to the GL picture. Nothing of the program belongs outside the window rect: black there.
+ * Set from X11DRV_WindowPosChanged (win data held), read at flush (surface lock held) -- no lock taken here. */
+static const struct window_surface_funcs x11drv_surface_funcs;
+
+void x11drv_surface_set_margins( struct window_surface *window_surface, const RECT *window, const RECT *visible )
+{
+    struct x11drv_window_surface *surface;
+    BOOL margins;
+
+    if (!window_surface || window_surface->funcs != &x11drv_surface_funcs) return;
+    surface = get_x11_surface( window_surface );
+    margins = !EqualRect( visible, window ) && visible->left <= window->left && visible->top <= window->top &&
+              visible->right >= window->right && visible->bottom >= window->bottom;
+    if (margins)
+    {
+        surface->margin_inner = *window;
+        OffsetRect( &surface->margin_inner, -visible->left, -visible->top );
+        surface->margin_size.cx = visible->right - visible->left;
+        surface->margin_size.cy = visible->bottom - visible->top;
+    }
+    surface->has_margins = margins;
+}
+
+static void fill_surface_margins( struct x11drv_window_surface *surface )
+{
+    RECT win = surface->margin_inner;
+    int w = surface->margin_size.cx, h = surface->margin_size.cy, count = 0;
+    XRectangle bands[4];
+
+    if (!surface->has_margins) return;
+    if (win.left > 0) bands[count++] = (XRectangle){ 0, 0, win.left, h };
+    if (win.right < w) bands[count++] = (XRectangle){ win.right, 0, w - win.right, h };
+    if (win.top > 0) bands[count++] = (XRectangle){ win.left, 0, win.right - win.left, win.top };
+    if (win.bottom < h) bands[count++] = (XRectangle){ win.left, win.bottom, win.right - win.left, h - win.bottom };
+    if (!count) return;
+    /* opaque black also for a 32-bit visual, where 0 is transparent */
+    XSetForeground( gdi_display, surface->gc, surface->image->ximage->depth == 32 ? 0xff000000 :
+                    BlackPixel( gdi_display, DefaultScreen( gdi_display ) ) );
+    XFillRectangles( gdi_display, surface->window, surface->gc, bands, count );
+}
