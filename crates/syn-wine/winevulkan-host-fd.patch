+/* syn-wine: VK_KHR_external_memory_fd and VK_EXT_external_memory_dma_buf are shown to applications only with
+ * WINE_VULKAN_HOST_FD=1 (Linux-aware helpers such as the DLSS 5 helper share images with host processes as dma-buf);
+ * the descriptors are host fds of this process. */
+static BOOL expose_host_fd(void)
+{
+    static int expose = -1;
+    if (expose == -1)
+    {
+        const char *env = getenv( "WINE_VULKAN_HOST_FD" );
+        expose = env && *env && *env != '0';
+#if defined(__linux__) && defined(PR_SET_PTRACER)
+        /* the peer takes its own reference with pidfd_getfd, which Yama (ptrace_scope 1) allows
+         * only to declared tracers */
+        if (expose && prctl( PR_SET_PTRACER, PR_SET_PTRACER_ANY, 0, 0, 0 ))
+            WARN( "PR_SET_PTRACER failed, peers may not be able to take exported fds\n" );
+#endif
+    }
+    return expose;
+}
