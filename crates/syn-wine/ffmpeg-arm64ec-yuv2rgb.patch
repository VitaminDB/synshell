ffmpeg (ARM64EC): yuv2rgb NEON clobbered the blue sums.

The ARM64EC port moved the sums from v20-v25 to v10-v15, but v10/v11 are also output registers
of the second 8 pixels for argb/abgr/bgra: writing r2/g2 there destroyed Y1+B1/Y2+B2 before b1/b2
were computed -> stripes in the blue channel (Media Foundation video in Unity games). Compute B first.

--- a/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S
+++ b/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S
@@ -202,12 +202,15 @@
         add             v15.8h, v5.8h, v15.8h                           // Y2 + G2
         add             v10.8h, v4.8h, v10.8h                           // Y1 + B1
         add             v11.8h, v5.8h, v11.8h                           // Y2 + B2
+        // B first: its sums live in v10/v11, which are also output registers
+        // of the second half for argb/abgr/bgra — writing r2/g2 there before
+        // would clobber Y1+B1 / Y2+B2 (garbage in blue, every other 8 pixels).
+        sqrshrun        \b1, v10.8h, #1                                 // clip_u8((Y1 + B1) >> 1)
+        sqrshrun        \b2, v11.8h, #1                                 // clip_u8((Y2 + B1) >> 1)
         sqrshrun        \r1, v12.8h, #1                                 // clip_u8((Y1 + R1) >> 1)
         sqrshrun        \r2, v13.8h, #1                                 // clip_u8((Y2 + R1) >> 1)
         sqrshrun        \g1, v14.8h, #1                                 // clip_u8((Y1 + G1) >> 1)
         sqrshrun        \g2, v15.8h, #1                                 // clip_u8((Y2 + G1) >> 1)
-        sqrshrun        \b1, v10.8h, #1                                 // clip_u8((Y1 + B1) >> 1)
-        sqrshrun        \b2, v11.8h, #1                                 // clip_u8((Y2 + B1) >> 1)
 .endm
 
 .macro declare_func ifmt ofmt
