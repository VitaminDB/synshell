+/* syn-wine: a thread bound to one CPU runs SCHED_BATCH. Windows does not let a thread readied by a wait preempt
+ * a running thread of the same priority; Linux does (wakeup preemption), and with in-process sync (ntsync) a
+ * woken thread runs at once. Programs that pin themselves to one CPU to serialise their threads (the SecuROM loader
+ * of Fable TLC: SetProcessAffinityMask 1) then race: a thread woken a moment after another one preempted it
+ * before it published its state, waited again and the start hung. SCHED_BATCH tasks do not preempt on wakeup.
+ * Its time slice is raised to a Windows quantum, so a tick preempts it in the middle of such a hand-off rarely.
+ * Only a thread with the default (or inherited batch) policy is switched, and only one switched here is switched back. */
+#if defined(__linux__) && defined(__NR_sched_setattr)
+struct syn_sched_attr
+{
+    unsigned int size, policy;
+    unsigned long long flags;
+    int nice;
+    unsigned int priority;
+    unsigned long long runtime, deadline, period;
+};
+#endif
+
+static void update_thread_sched_policy( struct thread *thread, affinity_t affinity )
+{
+#if defined(__linux__) && defined(__NR_sched_setattr)
+    struct syn_sched_attr attr;
+    int single = affinity && !(affinity & (affinity - 1));
+
+    if (thread->unix_tid == -1) return;
+    memset( &attr, 0, sizeof(attr) );
+    if (syscall( __NR_sched_getattr, thread->unix_tid, &attr, sizeof(attr), 0 )) return;
+    attr.size = sizeof(attr);
+    attr.flags = 0;
+    /* a thread created by a switched one inherits SCHED_BATCH but not the slice */
+    if (single && (attr.policy == SCHED_OTHER || attr.policy == SCHED_BATCH))
+    {
+        attr.policy = SCHED_BATCH;
+        attr.runtime = 30000000;  /* a Windows quantum (~2 ticks), not Linux's ~3 ms */
+        if (syscall( __NR_sched_setattr, thread->unix_tid, &attr, 0 ))
+        {
+            attr.runtime = 0;  /* kernel without custom slices */
+            if (syscall( __NR_sched_setattr, thread->unix_tid, &attr, 0 )) return;
+        }
+        thread->sched_batch = 1;
+    }
+    else if (!single && thread->sched_batch)
+    {
+        if (attr.policy == SCHED_BATCH)
+        {
+            attr.policy = SCHED_OTHER;
+            attr.runtime = 0;
+            syscall( __NR_sched_setattr, thread->unix_tid, &attr, 0 );
+        }
+        thread->sched_batch = 0;
+    }
+#endif
+}
+
 int set_thread_affinity( struct thread *thread, affinity_t affinity )
 {
     int ret = 0;
@@ -752,6 +809,7 @@
