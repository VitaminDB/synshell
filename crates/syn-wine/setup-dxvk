#!/bin/sh
# Установка/удаление DXVK в WINEPREFIX для syn-wine.
#   setup-dxvk install [arm64ec|x64|aarch64]   (по умолчанию: aarch64 — arm64ec, x86_64 — x64)
#   setup-dxvk uninstall
set -e

DXVK_DIR=/usr/share/dxvk
DLLS="d3d8 d3d9 d3d10core d3d11 dxgi"
action=${1:-install}
case "$(uname -m)" in aarch64) def=arm64ec ;; *) def=x64 ;; esac
variant=${2:-$def}
prefix=${WINEPREFIX:-$HOME/.wine}

[ -d "$prefix/drive_c/windows" ] || wineboot -u
sys32="$prefix/drive_c/windows/system32"
syswow="$prefix/drive_c/windows/syswow64"

case "$action" in
install)
  [ -d "$DXVK_DIR/$variant" ] || { echo "нет варианта: $variant" >&2; exit 1; }
  for d in $DLLS; do
    cp -f "$DXVK_DIR/$variant/$d.dll" "$sys32/$d.dll"
    [ -d "$syswow" ] && cp -f "$DXVK_DIR/x32/$d.dll" "$syswow/$d.dll"
    wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$d" /d native /f >/dev/null
  done
  echo "DXVK ($variant + x32) установлен в $prefix"
  ;;
uninstall)
  for d in $DLLS; do
    wine reg delete 'HKCU\Software\Wine\DllOverrides' /v "$d" /f >/dev/null 2>&1 || true
    rm -f "$sys32/$d.dll" "$syswow/$d.dll"
  done
  wineboot -u
  echo "DXVK удалён из $prefix"
  ;;
*)
  echo "использование: setup-dxvk install [arm64ec|x64|aarch64] | uninstall" >&2
  exit 1
  ;;
esac
