# src/main.rs
"synlink — связь оболочек synshell (телефон ↔ компьютер) по USB и Wi-Fi\n\nsynlink daemon                         демон (запускается сеансом сам)\nsynlink status [--json]                эта машина, кабель, устройства\nsynlink events                         события демона (JSON)\nsynlink pair УСТР | pair accept|reject УСТР   спаривание\nsynlink unpair УСТР | disconnect УСТР\nsynlink shot УСТР [-o ФАЙЛ] [--max N] [--output ВЫВОД]   снимок экрана (PNG)\nsynlink tap УСТР X Y | hold УСТР X Y [МС] | swipe УСТР X1 Y1 X2 Y2 [МС] | pinch УСТР X Y ОТ ДО [МС]\nsynlink scroll УСТР X Y ШАГИ           колесо (вниз — положительные)\nsynlink type УСТР ТЕКСТ | key УСТР СОЧЕТАНИЕ | action УСТР ДЕЙСТВИЕ\nsynlink windows УСТР | outputs УСТР | wm УСТР JSON\nsynlink exec УСТР [--cwd К] -- КОМАНДА...   команда (вывод потоком, код выхода)\nsynlink shell УСТР                     терминал на устройстве\nsynlink logs УСТР [-f] [-n N] [-u ЮНИТ] [--grep Ш]   журнал systemd\nsynlink proxy УСТР [ПОРТ]              stdin/stdout ↔ 127.0.0.1:ПОРТ (по умолч. sshd)\nsynlink mount УСТР | umount УСТР       файлы устройства (FUSE)\nsynlink notifications [УСТР]           уведомления с устройств\nsynlink view УСТР                      окно трансляции (synlink-view)\nsynlink audio УСТР on|off [--no-mic]   звук трансляции: звук устройства здесь,\n                                       микрофон отсюда — там («synlink-mic»)\nsynlink wifi-import КОМП | wifi-import accept|reject КОМП\n                                       на телефоне: перенести сети Wi-Fi компьютера\n                                       (спросит согласия на экране телефона)\nsynlink mcp                            MCP-сервер (stdio) для Claude Code\nsynlink session                        демон для автозапуска сеанса: юнитом\n                                       systemd --user (synlink.service), иначе сам\n\nX Y — пиксели снимка экрана устройства или доли 0..1. УСТР — имя, id,\nphone/desktop или local (эта машина). ssh: `ssh phone` / `ssh <имя>`." = "synlink — synshell kabukları arasında bağlantı (telefon ↔ bilgisayar), USB ve Wi-Fi üzerinden\n\nsynlink daemon                         hizmet (oturum kendisi başlatır)\nsynlink status [--json]                bu makine, kablo, aygıtlar\nsynlink events                         hizmet olayları (JSON)\nsynlink pair AYG | pair accept|reject AYG   eşleştirme\nsynlink unpair AYG | disconnect AYG\nsynlink shot AYG [-o DOSYA] [--max N] [--output ÇIKIŞ]   ekran görüntüsü (PNG)\nsynlink tap AYG X Y | hold AYG X Y [MS] | swipe AYG X1 Y1 X2 Y2 [MS] | pinch AYG X Y BAŞ SON [MS]\nsynlink scroll AYG X Y ADIM            tekerlek (pozitif aşağı)\nsynlink type AYG METİN | key AYG KISAYOL | action AYG EYLEM\nsynlink windows AYG | outputs AYG | wm AYG JSON\nsynlink exec AYG [--cwd DİZ] -- KOMUT...   komut (akış çıktısı, çıkış kodu)\nsynlink shell AYG                      aygıtta uçbirim\nsynlink logs AYG [-f] [-n N] [-u BİRİM] [--grep DES]   systemd günlüğü\nsynlink proxy AYG [PORT]               stdin/stdout ↔ 127.0.0.1:PORT (varsayılan sshd)\nsynlink mount AYG | umount AYG         aygıt dosyaları (FUSE)\nsynlink notifications [AYG]            aygıtlardan bildirimler\nsynlink view AYG                       yayın penceresi (synlink-view)\nsynlink audio AYG on|off [--no-mic]    yayın sesi: aygıtın sesi burada,\n                                       buranın mikrofonu orada (“synlink-mic”)\nsynlink wifi-import BİLG | wifi-import accept|reject BİLG\n                                       telefonda: bilgisayarın Wi-Fi ağlarını aktar\n                                       (telefon ekranında onay ister)\nsynlink mcp                            Claude Code için MCP sunucusu (stdio)\nsynlink session                        oturum otomatik başlatması için hizmet:\n                                       systemd --user birimi (synlink.service), yoksa doğrudan\n\nX Y — aygıt ekran görüntüsünün pikselleri veya 0..1 oranları. AYG — ad, id,\nphone/desktop veya local (bu makine). ssh: `ssh phone` / `ssh <ad>`."
