/* ── QuitSmoke · токены тёмной темы (вторичная) ────────────────────── */

:root {
    --bg: #0e1913;
    --surface: #16241c;
    --surface-2: #1b2e23;
    --fg: #e8f3ec;
    --fg-muted: #9db8a8;
    --accent: #34d17f;
    --accent-2: #2fbf71;
    --accent-soft: #1e3a2b;
    --amber: #f2a154;
    --amber-soft: #33291c;
    --rose: #ef6f6c;
    --rose-soft: #34221f;
    --blue: #5aa9f0;
    --blue-soft: #1a2a3a;
    --border: #24382c;
    --nav-bg: #12201a;
    --ring-track: #24382c;
    --shadow: rgba(0, 0, 0, 0.35);
    --hero-a: #1fa862;
    --hero-b: #34d17f;
    --accent-text: #06120b;
    --vape: #3ec9d6;
    --vape-soft: #1a3a3f;
}
