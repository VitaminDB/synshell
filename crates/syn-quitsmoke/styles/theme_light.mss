/* ── QuitSmoke · токены светлой темы (флагман) ─────────────────────── */

:root {
    --bg: #eaf6ee;
    --surface: #ffffff;
    --surface-2: #f3faf5;
    --fg: #14261c;
    --fg-muted: #5d7568;
    --accent: #2fbf71;
    --accent-2: #16a65c;
    --accent-soft: #d9f2e3;
    --amber: #f2a154;
    --amber-soft: #fdeedd;
    --rose: #ef6f6c;
    --rose-soft: #fde3e2;
    --blue: #4c9be8;
    --blue-soft: #dfeefb;
    --vape: #3ec9d6;
    --vape-soft: #d8f4f7;
    --border: #d9ece1;
    --nav-bg: #ffffff;
    --ring-track: #e0efe6;
    --shadow: rgba(24, 84, 54, 0.10);
    --hero-a: #2fbf71;
    --hero-b: #7ad0a0;
    --accent-text: #ffffff;
}
