"  --present-dump МАШИНА ФАЙЛ.png         экран гостя с кадром игры syn-gpu поверх (проверка слоя без окна)" = "  --present-dump МАШИНА ФАЙЛ.png         қонақ экраны, үстінде syn-gpu ойын кадры (қабатты терезесіз тексеру)"
