"  --optimize МАШИНА [--apply]            Windows: быстрое видео, агент, диск инструментов; советы по диску и сети" = "  --optimize MASZYNA [--apply]           Windows: szybkie wideo, agent, płyta narzędzi; porady dotyczące dysku i sieci"
"syn-vm — виртуальные машины QEMU/KVM\n\nОкно:\n  syn-vm [МАШИНА] [--tab screen|overview|settings|snapshots] [--new-window]\n  syn-vm --screenshot СНИМОК.png [--size ШxВ] [--scale N] [--open МАШИНА] [--tab …] [--wizard ШАГ]   снимок окна\n\nМашины (МАШИНА — имя или id):\n  --list [--json]                        машины и их состояние\n  --status МАШИНА [--json]               состояние, агент, система гостя, адреса, порты\n  --start МАШИНА [--wait-boot [СЕК]]     запустить без окна (и ждать гостевого агента)\n  --stop МАШИНА [--force] [--timeout СЕК]  выключить (агентом или ACPI); --force — выдернуть шнур по тайм-ауту\n  --kill МАШИНА                          выключить сразу\n  --reset | --pause | --resume МАШИНА\n  --wait-boot МАШИНА [--timeout СЕК]     ждать, пока ответит гостевой агент (300 с)\n  --new ИМЯ [--iso ОБРАЗ] [--os linux|windows11|windows10|bsd|android|other]\n        [--disk ФАЙЛ …] [--vars ФАЙЛ] [--tpm КАТАЛОГ] [--cpus N] [--memory МБ] [--disk-gb N]\n        [--firmware bios|uefi|uefi-secure] [--disk-bus virtio|sata|nvme] [--nic virtio|e1000e|rtl8139]\n        [--fwd [udp:]ХОСТ:ГОСТЬ …] [--public] [--share КАТАЛОГ] [--set КЛЮЧ=ЗНАЧЕНИЕ …]\n                                          новая машина; с --disk — импорт готовой (диск остаётся на месте,\n                                          переменные UEFI и TPM копируются в папку машины;\n                                          пробросы слушают 127.0.0.1, --public — все адреса)\n  --delete МАШИНА --yes                  удалить машину и диски в её папке\n  --get МАШИНА [КЛЮЧ]                    настройки (TOML) или одно значение\n  --set МАШИНА КЛЮЧ=ЗНАЧЕНИЕ …           изменить настройки (значение — TOML или строка)\n\nГость (через гостевой агент qemu-ga):\n  --exec МАШИНА [--timeout СЕК] [--env К=З …] [--stdin] [--raw] -- ПРОГРАММА [АРГ…]\n                                          (вывод Windows переводится из OEM-кодировки в UTF-8; --raw — как есть)\n  --sh МАШИНА [--timeout СЕК] 'КОМАНДА'  через оболочку гостя (sh -c / cmd /c)\n       --detach (у --exec и --sh) — не ждать, напечатать pid в госте\n  --exec-status МАШИНА PID [--wait СЕК]  итог фоновой команды: вывод и её код; 125 — ещё работает\n                                          (вывод агент отдаёт один раз)\n  --push МАШИНА ФАЙЛ ПУТЬ_В_ГОСТЕ        файл в гостя\n  --pull МАШИНА ПУТЬ_В_ГОСТЕ ФАЙЛ        файл из гостя\n  --agent МАШИНА КОМАНДА [JSON]          сырая команда агента (guest-info, guest-get-osinfo…)\n  --sync-time МАШИНА                     часы гостя по компьютеру\n\nЭкран и ввод (без окна, работает и без агента):\n  --screendump МАШИНА ФАЙЛ.png           кадр экрана гостя\n  --type МАШИНА 'ТЕКСТ'                  набрать текст (раскладка US, \\n — Enter)\n  --key МАШИНА СОЧЕТАНИЕ                 ctrl+alt+delete, alt+f4, win+r, enter…\n  --click МАШИНА X Y [--right|--middle] [--double] [--move]   щелчок в пикселях кадра\n  --scroll МАШИНА ШАГИ                   колесо (> 0 — вниз)\n\nУстройства:\n  --devices [--json]                     что можно отдать гостю: PCI, ввод, диски, порты, USB\n  --usb МАШИНА list|attach|detach [ПОРТ] USB по физическому порту (3-6, 1-2.4)\n  --attach МАШИНА ТИП:ИД                 pci:02:00.0, input:/dev/input/by-id/…, block:/dev/sdb,\n                                          block-ro:/dev/sdb1, serial:/dev/ttyUSB0, usb-id:VID:PID, usb:3-6\n  --detach МАШИНА ТИП:ИД\n  --cdrom МАШИНА ОБРАЗ|eject             образ в приводе\n  --tools МАШИНА [on|off|download|ОБРАЗ.iso]  диск «Гостевые инструменты» (virtio-win)\n\nЗапись экрана гостя (родное разрешение, ровная частота, ffmpeg: NVENC/VAAPI/x264):\n  --record МАШИНА [ФАЙЛ.mp4] [--fps 30|60] [--audio|--no-audio] [--duration СЕК]\n                                          без --duration — в фоне до --record-stop; звук — если он включён у машины\n  --record-stop МАШИНА                   остановить, дождаться файла, итог\n\nПрочее:\n  --snapshot МАШИНА list|create|restore|delete [ИМЯ]\n  --qmp МАШИНА КОМАНДА [JSON]            сырая команда QMP\n  --mcp                                   MCP-сервер (stdio): claude mcp add syn-vm -- syn-vm --mcp\n" = "syn-vm — maszyny wirtualne QEMU/KVM\n\nOkno:\n  syn-vm [MASZYNA] [--tab screen|overview|settings|snapshots] [--new-window]\n  syn-vm --screenshot ZRZUT.png [--size SZxW] [--scale N] [--open MASZYNA] [--tab …] [--wizard KROK]   zrzut okna\n\nMaszyny (MASZYNA — nazwa lub id):\n  --list [--json]                        maszyny i ich stan\n  --status MASZYNA [--json]              stan, agent, system gościa, adresy, porty\n  --start MASZYNA [--wait-boot [SEK]]    uruchomienie bez okna (i oczekiwanie na agenta gościa)\n  --stop MASZYNA [--force] [--timeout SEK]  zamknięcie (agent lub ACPI); --force — odcięcie zasilania po czasie\n  --kill MASZYNA                         natychmiastowe wyłączenie\n  --reset | --pause | --resume MASZYNA\n  --wait-boot MASZYNA [--timeout SEK]    czekanie, aż agent gościa odpowie (300 s)\n  --new NAZWA [--iso OBRAZ] [--os linux|windows11|windows10|bsd|android|other]\n        [--disk PLIK …] [--vars PLIK] [--tpm KATALOG] [--cpus N] [--memory MB] [--disk-gb N]\n        [--firmware bios|uefi|uefi-secure] [--disk-bus virtio|sata|nvme] [--nic virtio|e1000e|rtl8139]\n        [--fwd [udp:]HOST:GOŚĆ …] [--public] [--share KATALOG] [--set KLUCZ=WARTOŚĆ …]\n                                          nowa maszyna; z --disk — import istniejącej (dysk zostaje na miejscu,\n                                          zmienne UEFI i TPM są kopiowane do folderu maszyny;\n                                          przekierowania nasłuchują na 127.0.0.1, --public — na wszystkich adresach)\n  --delete MASZYNA --yes                 usunięcie maszyny i dysków w jej folderze\n  --get MASZYNA [KLUCZ]                  ustawienia (TOML) lub pojedyncza wartość\n  --set MASZYNA KLUCZ=WARTOŚĆ …          zmiana ustawień (wartość — TOML lub ciąg)\n\nGość (przez agenta gościa qemu-ga):\n  --exec MASZYNA [--timeout SEK] [--env K=V …] [--stdin] [--raw] -- PROGRAM [ARG…]\n                                          (wyjście Windows jest konwertowane ze strony kodowej OEM na UTF-8; --raw — bez zmian)\n  --sh MASZYNA [--timeout SEK] 'POLECENIE' przez powłokę gościa (sh -c / cmd /c)\n       --detach (dla --exec i --sh) — bez czekania, wypisuje pid w gościu\n  --exec-status MASZYNA PID [--wait SEK] wynik polecenia w tle: wyjście i kod wyjścia; 125 — nadal działa\n                                          (agent zwraca wyjście tylko raz)\n  --push MASZYNA PLIK ŚCIEŻKA_GOŚCIA     plik do gościa\n  --pull MASZYNA ŚCIEŻKA_GOŚCIA PLIK     plik z gościa\n  --agent MASZYNA POLECENIE [JSON]       surowe polecenie agenta (guest-info, guest-get-osinfo…)\n  --sync-time MASZYNA                    ustawienie zegara gościa według komputera\n\nEkran i wejście (bez okna, działa również bez agenta):\n  --screendump MASZYNA PLIK.png          klatka ekranu gościa\n  --type MASZYNA 'TEKST'                 wpisanie tekstu (układ US, \\n — Enter)\n  --key MASZYNA SKRÓT                    ctrl+alt+delete, alt+f4, win+r, enter…\n  --click MASZYNA X Y [--right|--middle] [--double] [--move]   kliknięcie w pikselach klatki\n  --scroll MASZYNA KROKI                 kółko (> 0 — w dół)\n\nUrządzenia:\n  --devices [--json]                     co można przekazać gościowi: PCI, wejście, dyski, porty, USB\n  --usb MASZYNA list|attach|detach [PORT] USB według portu fizycznego (3-6, 1-2.4)\n  --attach MASZYNA TYP:ID                pci:02:00.0, input:/dev/input/by-id/…, block:/dev/sdb,\n                                          block-ro:/dev/sdb1, serial:/dev/ttyUSB0, usb-id:VID:PID, usb:3-6\n  --detach MASZYNA TYP:ID\n  --cdrom MASZYNA OBRAZ|eject            obraz w napędzie\n  --tools MASZYNA [on|off|download|OBRAZ.iso]  płyta „Guest Tools” (virtio-win)\n\nNagrywanie ekranu gościa (natywna rozdzielczość, stała liczba klatek, ffmpeg: NVENC/VAAPI/x264):\n  --record MASZYNA [PLIK.mp4] [--fps 30|60] [--audio|--no-audio] [--duration SEK]\n                                          bez --duration — w tle do --record-stop; dźwięk — jeśli włączony dla maszyny\n  --record-stop MASZYNA                  zatrzymanie, czekanie na plik, podsumowanie\n\nInne:\n  --snapshot MASZYNA list|create|restore|delete [NAZWA]\n  --qmp MASZYNA POLECENIE [JSON]         surowe polecenie QMP\n  --mcp                                   serwer MCP (stdio): claude mcp add syn-vm -- syn-vm --mcp\n"
