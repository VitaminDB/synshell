# src/cli.rs
"syn-vm — виртуальные машины QEMU/KVM\n\nОкно:\n  syn-vm [МАШИНА] [--tab screen|overview|settings|snapshots] [--new-window]\n  syn-vm --screenshot СНИМОК.png [--size ШxВ] [--scale N] [--open МАШИНА] [--tab …] [--wizard ШАГ]   снимок окна\n\nМашины (МАШИНА — имя или id):\n  --list [--json]                        машины и их состояние\n  --status МАШИНА [--json]               состояние, агент, система гостя, адреса, порты\n  --start МАШИНА [--wait-boot [СЕК]]     запустить без окна (и ждать гостевого агента)\n  --stop МАШИНА [--force] [--timeout СЕК]  выключить (агентом или ACPI); --force — выдернуть шнур по тайм-ауту\n  --kill МАШИНА                          выключить сразу\n  --reset | --pause | --resume МАШИНА\n  --wait-boot МАШИНА [--timeout СЕК]     ждать, пока ответит гостевой агент (300 с)\n  --new ИМЯ [--iso ОБРАЗ] [--os linux|windows11|windows10|bsd|android|other]\n        [--disk ФАЙЛ …] [--vars ФАЙЛ] [--tpm КАТАЛОГ] [--cpus N] [--memory МБ] [--disk-gb N]\n        [--firmware bios|uefi|uefi-secure] [--disk-bus virtio|sata|nvme] [--nic virtio|e1000e|rtl8139]\n        [--fwd [udp:]ХОСТ:ГОСТЬ …] [--public] [--share КАТАЛОГ] [--set КЛЮЧ=ЗНАЧЕНИЕ …]\n                                          новая машина; с --disk — импорт готовой (диск остаётся на месте,\n                                          переменные UEFI и TPM копируются в папку машины;\n                                          пробросы слушают 127.0.0.1, --public — все адреса)\n  --delete МАШИНА --yes                  удалить машину и диски в её папке\n  --get МАШИНА [КЛЮЧ]                    настройки (TOML) или одно значение\n  --set МАШИНА КЛЮЧ=ЗНАЧЕНИЕ …           изменить настройки (значение — TOML или строка)\n\nГость (через гостевой агент qemu-ga):\n  --exec МАШИНА [--timeout СЕК] [--env К=З …] [--stdin] [--raw] -- ПРОГРАММА [АРГ…]\n                                          (вывод Windows переводится из OEM-кодировки в UTF-8; --raw — как есть)\n  --sh МАШИНА [--timeout СЕК] 'КОМАНДА'  через оболочку гостя (sh -c / cmd /c)\n       --detach (у --exec и --sh) — не ждать, напечатать pid в госте\n  --exec-status МАШИНА PID [--wait СЕК]  итог фоновой команды: вывод и её код; 125 — ещё работает\n                                          (вывод агент отдаёт один раз)\n  --push МАШИНА ФАЙЛ ПУТЬ_В_ГОСТЕ        файл в гостя\n  --pull МАШИНА ПУТЬ_В_ГОСТЕ ФАЙЛ        файл из гостя\n  --agent МАШИНА КОМАНДА [JSON]          сырая команда агента (guest-info, guest-get-osinfo…)\n  --sync-time МАШИНА                     часы гостя по компьютеру\n\nЭкран и ввод (без окна, работает и без агента):\n  --screendump МАШИНА ФАЙЛ.png           кадр экрана гостя\n  --type МАШИНА 'ТЕКСТ'                  набрать текст (раскладка US, \\n — Enter)\n  --key МАШИНА СОЧЕТАНИЕ                 ctrl+alt+delete, alt+f4, win+r, enter…\n  --click МАШИНА X Y [--right|--middle] [--double] [--move]   щелчок в пикселях кадра\n  --scroll МАШИНА ШАГИ                   колесо (> 0 — вниз)\n\nУстройства:\n  --devices [--json]                     что можно отдать гостю: PCI, ввод, диски, порты, USB\n  --usb МАШИНА list|attach|detach [ПОРТ] USB по физическому порту (3-6, 1-2.4)\n  --attach МАШИНА ТИП:ИД                 pci:02:00.0, input:/dev/input/by-id/…, block:/dev/sdb,\n                                          block-ro:/dev/sdb1, serial:/dev/ttyUSB0, usb-id:VID:PID, usb:3-6\n  --detach МАШИНА ТИП:ИД\n  --cdrom МАШИНА ОБРАЗ|eject             образ в приводе\n  --tools МАШИНА [on|off|download|ОБРАЗ.iso]  диск «Гостевые инструменты» (virtio-win)\n\nЗапись экрана гостя (родное разрешение, ровная частота, ffmpeg: NVENC/VAAPI/x264):\n  --record МАШИНА [ФАЙЛ.mp4] [--fps 30|60] [--audio|--no-audio] [--duration СЕК]\n                                          без --duration — в фоне до --record-stop; звук — если он включён у машины\n  --record-stop МАШИНА                   остановить, дождаться файла, итог\n\nПрочее:\n  --snapshot МАШИНА list|create|restore|delete [ИМЯ]\n  --qmp МАШИНА КОМАНДА [JSON]            сырая команда QMP\n  --mcp                                   MCP-сервер (stdio): claude mcp add syn-vm -- syn-vm --mcp\n" = "syn-vm — QEMU/KVM virtual machines\n\nWindow:\n  syn-vm [MACHINE] [--tab screen|overview|settings|snapshots] [--new-window]\n  syn-vm --screenshot SHOT.png [--size WxH] [--scale N] [--open MACHINE] [--tab …] [--wizard STEP]   window screenshot\n\nMachines (MACHINE — name or id):\n  --list [--json]                        machines and their state\n  --status MACHINE [--json]              state, agent, guest OS, addresses, ports\n  --start MACHINE [--wait-boot [SEC]]    start without a window (and wait for the guest agent)\n  --stop MACHINE [--force] [--timeout SEC]  shut down (agent or ACPI); --force — pull the plug on timeout\n  --kill MACHINE                         power off immediately\n  --reset | --pause | --resume MACHINE\n  --wait-boot MACHINE [--timeout SEC]    wait until the guest agent responds (300 s)\n  --new NAME [--iso IMAGE] [--os linux|windows11|windows10|bsd|android|other]\n        [--disk FILE …] [--vars FILE] [--tpm DIR] [--cpus N] [--memory MB] [--disk-gb N]\n        [--firmware bios|uefi|uefi-secure] [--disk-bus virtio|sata|nvme] [--nic virtio|e1000e|rtl8139]\n        [--fwd [udp:]HOST:GUEST …] [--public] [--share DIR] [--set KEY=VALUE …]\n                                          new machine; with --disk — import an existing one (the disk stays in place,\n                                          UEFI variables and TPM are copied to the machine folder;\n                                          forwards listen on 127.0.0.1, --public — on all addresses)\n  --delete MACHINE --yes                 delete the machine and the disks in its folder\n  --get MACHINE [KEY]                    settings (TOML) or a single value\n  --set MACHINE KEY=VALUE …              change settings (value — TOML or a string)\n\nGuest (via the qemu-ga guest agent):\n  --exec MACHINE [--timeout SEC] [--env K=V …] [--stdin] [--raw] -- PROGRAM [ARG…]\n                                          (Windows output is converted from the OEM code page to UTF-8; --raw — as is)\n  --sh MACHINE [--timeout SEC] 'COMMAND' via the guest shell (sh -c / cmd /c)\n       --detach (for --exec and --sh) — don't wait, print the pid in the guest\n  --exec-status MACHINE PID [--wait SEC] result of a background command: output and exit code; 125 — still running\n                                          (the agent returns the output only once)\n  --push MACHINE FILE GUEST_PATH         file to the guest\n  --pull MACHINE GUEST_PATH FILE         file from the guest\n  --agent MACHINE COMMAND [JSON]         raw agent command (guest-info, guest-get-osinfo…)\n  --sync-time MACHINE                    set the guest clock from the computer\n\nScreen and input (no window, works without the agent too):\n  --screendump MACHINE FILE.png          guest screen frame\n  --type MACHINE 'TEXT'                  type text (US layout, \\n — Enter)\n  --key MACHINE COMBO                    ctrl+alt+delete, alt+f4, win+r, enter…\n  --click MACHINE X Y [--right|--middle] [--double] [--move]   click in frame pixels\n  --scroll MACHINE STEPS                 wheel (> 0 — down)\n\nDevices:\n  --devices [--json]                     what can be given to the guest: PCI, input, disks, ports, USB\n  --usb MACHINE list|attach|detach [PORT] USB by physical port (3-6, 1-2.4)\n  --attach MACHINE TYPE:ID               pci:02:00.0, input:/dev/input/by-id/…, block:/dev/sdb,\n                                          block-ro:/dev/sdb1, serial:/dev/ttyUSB0, usb-id:VID:PID, usb:3-6\n  --detach MACHINE TYPE:ID\n  --cdrom MACHINE IMAGE|eject            image in the drive\n  --tools MACHINE [on|off|download|IMAGE.iso]  \"Guest Tools\" disc (virtio-win)\n\nGuest screen recording (native resolution, steady frame rate, ffmpeg: NVENC/VAAPI/x264):\n  --record MACHINE [FILE.mp4] [--fps 30|60] [--audio|--no-audio] [--duration SEC]\n                                          without --duration — in the background until --record-stop; audio — if enabled for the machine\n  --record-stop MACHINE                  stop, wait for the file, summary\n\nOther:\n  --snapshot MACHINE list|create|restore|delete [NAME]\n  --qmp MACHINE COMMAND [JSON]           raw QMP command\n  --mcp                                   MCP server (stdio): claude mcp add syn-vm -- syn-vm --mcp\n"
