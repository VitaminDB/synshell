"  --optimize МАШИНА [--apply]            Windows: быстрое видео, агент, диск инструментов; советы по диску и сети" = "  --optimize МАШИНА [--apply]            Windows: швидке відео, агент, диск інструментів; поради щодо диска й мережі"
"  --present-dump МАШИНА ФАЙЛ.png         экран гостя с кадром игры syn-gpu поверх (проверка слоя без окна)" = "  --present-dump МАШИНА ФАЙЛ.png         екран гостя з кадром гри syn-gpu поверх (перевірка шару без вікна)"
