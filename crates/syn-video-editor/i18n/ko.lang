settings.scripts.template = "//! name: {name}\n//! title: My script\n//! description: what the script does in one sentence\n//! params: length — length, s (30)\n\nlet p = project();\nlet len = num(params.length, 30.0);\n// example: fade in every clip on video tracks\nfor t in list(p.tracks) {\n    if t.kind == \"video\" {\n        for c in list(t.clips) {\n            cmd(\"effect.add\", #{ids: [c.id], kind: \"fade_in\"});\n        }\n    }\n}\nprint(`done, length ${len} s`);\n"
