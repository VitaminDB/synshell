.statusbar {
    height: 28px;
    padding: 0 14px;
    background-color: var(--bg-shell);
}

.status-text {
    font-size: 12px;
    color: var(--text-muted);
}

.status-strong {
    font-size: 12px;
    color: var(--text);
    font-family: monospace;
}

.status-chip {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-hover);
}

.status-chip-warn {
    background-color: var(--warning-soft);
}

.status-chip-warn .status-text { color: var(--modified); }
